# Generated by Cargo
# will have compiled files and executables
debug/
target/

# These are backup files generated by rustfmt
**/*.rs.bk

# MSVC Windows builds of rustc generate these, which store debugging information
*.pdb

.vscode/settings.json
.env

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# WEB
# Build output; package.json is the tracked manifest of each WASM package
web/wasm/*/*
!web/wasm/*/package.json
node_modules
dist
dist-example
dist-ssr
site-dist
*.local
!web/**/example/pages/debug

# Docs (Astro)
.astro/

# Wrangler local dev state
.wrangler/

# Packed externals for internal distribution
externals

# Editor directories and files
.vscode/*
!.vscode/extensions.json
.idea
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?

promo-captures/*
