  "example-row2-center": ["google"], // weather/precipitation
  "example-row2-right": ["google"], // sky/sun-time
  "example-row3-left": ["reearthPapers", "naturalEarth"], // evaluator/text
  "example-row3-right": ["reearthTerrain", "gsiPhoto", "plateauChuo"], // effect/ssr
  "example-row4-left": ["reearthTerrain", "mapterhorn", "reearthPapers", "plateauKyoto"], // evaluator/color
  "example-row4-center-left": ["reearthPapers", "osm"], // effect/selective-bloom
  "example-row4-center-right": ["reearthPapers", "eoxS2016", "sunnyMeadow"], // mesh/splat
  "example-row4-right": ["reearthTerrain", "reearthPapers", "osm"], // effect/fog-light
};
const attrib = (id: string) => (TILE_SOURCES[id] ?? []).map((k) => SRC[k]);
const galleryAttribLabel = t.gallery.mediaAttributionLabel;
const googleLogoSrc = googleMapsLogo.src;

// Showcases: sites built with Navara, a third grid in the gallery strip
// (after tutorial and example). Items are the `showcase-*` slots in lp.json
// (numeric order; `href` is each site's URL, alt — reused as the hover title —
// in imageAlts). If a showcase ever uses Google Photorealistic 3D Tiles, its
// tile must carry the Google logo (see the example tiles' `logo` prop).
const showcaseIds = Object.keys(images)
  .filter((id) => id.startsWith("showcase-"))
  .sort((a, b) => a.localeCompare(b, undefined, { numeric: true }));

// Showcase tile credits, extracted verbatim from each site's own Navara
// attribution UI (minus its Navara self-credits, redundant on Navara's LP).
// Rows that carried several links in the source UI are split so every credit
// keeps its link. Re-extract these when a site's data sources change.
const SHOWCASE_ATTRIB: Record<string, { text: string; href?: string }[]> = {
