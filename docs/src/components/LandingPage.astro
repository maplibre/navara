// The "4 API tiers" showcase still and the MapLibre still, credited inline.
const whyAttrib = [
  SRC.plateauGeneric,
  SRC.reearthTerrain,
  SRC.reearthPapers,
  SRC.protomapsPlain,
  SRC.osm,
];
const maplibreAttrib = [SRC.osm, SRC.protomaps];

// The MapLibre-family section is parked until its story (style plugin / MLT)
// is further along; flip to true to bring it back.
const SHOW_MAPLIBRE = false;

// Hello world: the entire first program, shown whole in the HELLO WORLD
// section. A TileJSON-based take on the docs' Getting Started example
// (guides/Introduction/getting-started.mdx) — the TileJSON document supplies
// the tile URL, zoom range, and data attribution, which keeps the program
// short without dropping the credits. Every API call is real; verify against
// the docs before editing.
const helloCode = `// Initialization
const view = new ThreeView({ useNormal: true });
const defaultPlugin = new DefaultPlugin();
const tilejson = new TileJsonPlugin();
view.addPlugin(defaultPlugin);
view.addPlugin(tilejson);
await view.init();

// Setting up default atmosphere
defaultPlugin.addDefaultPhotorealScene();
view.atmosphere.date = new Date("2026-07-16T01:00:00Z");
view.toneMappingExposure = 10;

// Raster tile
const source = await tilejson.addSource({
  type: "raster-tile",
  url: "https://papers.reearth.land/bluemarble/tilejson.json",
});
view.addLayer({ type: "raster", source });`;

const helloAttrib = [SRC.nasaGibs, SRC.reearthPapers];
const outroAttrib = [SRC.nasaBlackMarble, SRC.reearthPapers];

// Scene-synced credits for the looping promo video: the credit line baked
// into the video's bottom edge is cropped away by the full-bleed cover fit,
// so the LP overlays its own block per scene and swaps it with playback.
// `end` is where each scene's credits stop applying (seconds in the published
// 38 s cut, read off its frames; scene changes are ~0.6 s crossfades so
// ±0.3 s is fine) — past the last end the loop-closing still repeats the
// dive's first frame, and the script wraps back to the first block. The
// Google scenes carry the always-visible Google logo, shown only while
// Photorealistic 3D Tiles are on screen; their credit list transcribes the
// per-tile copyright line the capture baked into those frames (identical for
// both Google scenes of this cut, order aside). Re-cutting the promo means
// re-reading these boundaries and credits from the new take.
const heroScenes = [
  // dive — EOX Sentinel-2 globe, Blue Marble clouds, Re:Earth terrain
  { end: 8.5, items: [SRC.eoxS2, SRC.nasaClouds, SRC.reearthTerrain] },
  // city (London) + storm (Shinjuku) — Google Photorealistic 3D Tiles
  {
    end: 19.0,
    google: true,
    items: [
      SRC.google,
      "Map data ©2026 Google",
      "Google",
      "Landsat / Copernicus",
      "Data SIO, NOAA, U.S. Navy, NGA, GEBCO",
      "Airbus",
    ],
  },
  // river — SSR skim over PLATEAU Chuo on GSI photo + Re:Earth terrain
  { end: 22.7, items: [SRC.reearthTerrain, SRC.gsiPhoto, SRC.plateauChuo] },
  // vector — Cairo 2.5D Overture basemap
  { end: 26.5, items: [SRC.osm, SRC.overture] },
  // heights + night — Manhattan MVT extrusions on Re:Earth Papers styles
  { end: 33.0, items: [SRC.reearthPapers, SRC.protomaps, SRC.osm] },
  // pullback — Black Marble globe on Re:Earth terrain
  { end: 37.2, items: [SRC.nasaBlackMarble, SRC.reearthPapers, SRC.reearthTerrain] },
];
---

<html lang={t.htmlLang} style={rootStyle}>
  <head>
    <meta charset="utf-8" />
    {/* viewport-fit=cover: the full-bleed media (hero video, closing globe)
        reaches the physical screen edges on notched phones; the --lp-safe-*
        vars below keep text and controls out of those areas. */}
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{t.meta.title}</title>
    <meta name="description" content={t.meta.description} />
    {/* Social thumbnail: the docs-wide promo poster crop (public/og.jpg). */}
    <meta property="og:site_name" content="Navara" />
    <meta property="og:type" content="website" />
    <meta property="og:title" content={t.meta.title} />
    <meta property="og:description" content={t.meta.description} />
    <meta property="og:image" content="https://navara.world/og.jpg" />
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:image" content="https://navara.world/og.jpg" />
    {/* iOS Safari tints its toolbars with this (it samples the page background
        otherwise): black, so the closing band reads as continuing past the URL
        bar — the page itself can never paint that area. */}
    <meta name="theme-color" content="#000000" />
    {/* TODO: Remove when Navara is released. */}
    <meta name="robots" content="noindex,nofollow" />
    <link rel="icon" href={`${DOCS_BASE}/favicon.png`} type="image/png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Arsenal:wght@400;700&family=Zen+Kaku+Gothic+New:wght@400;500;700&family=IBM+Plex+Mono:wght@400;500&display=swap"
      rel="stylesheet"
    />
  </head>
  <body>
    <div class="lp">
      <!-- Transparent header over hero (shared with the docs site — see
           LpHeader.astro). The brand logo starts hidden — the centered hero
           logo owns the branding — and fades in when the header frosts on
           scroll (lp-header-solid). -->
      <LpHeader locale={locale} variant="lp" />

      <!-- Hero stage: the hero image stays pinned while the transparent
           catch-copy section slides up over it; once that section is fully
           visible the page scrolls normally again. -->
      <div class="lp-hero-stage">
        <!-- Hero: the promo video loops behind the catch copy. An AVIF still
             (the video's own first frame) paints first and plays the opening
             animation; the video fades in over it once it is actually
             rolling, so there is never a black flash. Phones get the smaller
             encode plus a fullscreen button (the portrait crop hides most of
             the frame; fullscreen shows it all). Sources are picked by the
             script below; without JS (or with reduced motion) the still
             simply stays. -->
        <div class="lp-hero">
          <picture>
            <source
              media="(max-width: 640px)"
              srcset={`${DOCS_BASE}/promo/promo-poster-sp.avif`}
              type="image/avif"
            />
            <img src={`${DOCS_BASE}/promo/promo-poster.avif`} alt={t.hero.posterAlt} />
          </picture>
          <video
            class="lp-hero-video"
            muted
            loop
            playsinline
            preload="auto"
            aria-hidden="true"
            data-src={`${DOCS_BASE}/promo/navara-promo.mp4`}
            data-src-sp={`${DOCS_BASE}/promo/navara-promo-sp.mp4`}
          ></video>
          <!-- Brand lockup centered over the video; the intro panel slides up
               over it, at which point the header's own logo takes over. -->
          <Fragment set:html={logoSvg(logoVertical, "lp-hero-logo")} />
          <button class="lp-hero-fs" type="button" aria-label={t.hero.fullscreen}>
            <Maximize2 size={18} stroke-width={2} aria-hidden="true" />
          </button>
          <!-- Shown only when autoplay is refused (iOS Low Power Mode etc.):
               a play() from a tap is allowed even while autoplay is not. -->
          <button class="lp-hero-play" type="button" aria-label={t.hero.play}>
            <Play size={22} stroke-width={2} aria-hidden="true" />
          </button>
          <!-- Phone-only scroll cue: the full-viewport video gives no hint
               that the page continues; a pulsing chevron at the bottom center
               does, and fades out for good once scrolling starts. -->
          <div class="lp-hero-scroll-cue" aria-hidden="true">
            <ChevronDown size={22} stroke-width={2} />
          </div>
          <!-- The video's baked credit line sits on its bottom edge, which
               the full-bleed cover fit crops away — so the LP overlays the
               credits itself, one block per scene, swapped in sync with
               playback (see the script below). Without JS only the first
               block shows, matching the dive-frame poster. Bottom-left keeps
               clear of the phone fullscreen button and scroll cue. -->
          {
            heroScenes.map((scene, i) => (
              <div data-hero-scene-until={scene.end} hidden={i > 0}>
                <ImageAttribution
                  class="lp-hero-attrib"
                  items={scene.items}
                  label={t.hero.mediaAttributionLabel}
                  corner="bl"
                  logo={scene.google ? googleLogoSrc : undefined}
                  logoAlt={scene.google ? "Google Maps" : ""}
                />
              </div>
            ))
          }
        </div>
        <!-- Catch copy + intro -->
        <section class="lp-intro">
        <div class="lp-container lp-intro-grid">
          <div>
            <h1 class="lp-h1" set:html={t.intro.h1Html} />
            {t.intro.h1Sub && <p class="lp-h1-sub">{t.intro.h1Sub}</p>}
          </div>
          <div class="lp-intro-right">
            <p class="lp-intro-copy" set:html={t.intro.copyHtml} />
            <div class="lp-cta-row">
              <a class="lp-btn-primary" href={links.examples}>{t.intro.ctaExamples}</a>
              <a class="lp-btn-outline" href={localizeHref(links.docs)}>{t.intro.ctaDocs}</a>
