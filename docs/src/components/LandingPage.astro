---
// Landing page for Navara. Design reference: design_handoff_navara_landing_page.
// Theme colors, image slots, and external links are managed in src/data/lp.json;
// all copy lives in src/data/lp-locales/<locale>.json. To add a locale, create
// its strings file there and a page that renders <LandingPage locale="..." />.
// Image `src` values are repo-root-relative paths pointing into docs/src/assets
// or web/navara_three/example/public/screenshots.
import type { ImageMetadata } from "astro";
import { Code } from "astro:components";
import { ArrowUpRight, Check, ChevronDown, Maximize2, Play } from "@lucide/astro";
import lp from "../data/lp.json";
import ImageAttribution from "./ImageAttribution.astro";
import GalleryTile from "./GalleryTile.astro";
import LpHeader from "./LpHeader.astro";
import googleMapsLogo from "../assets/lp/google-maps-logo.png";
import archGlobe from "../assets/lp/arch-globe.svg?raw";
import archTerrain from "../assets/lp/arch-terrain.svg?raw";
import archBuildings from "../assets/lp/arch-buildings.svg?raw";
import archMarker from "../assets/lp/arch-marker.svg?raw";
import archArrow from "../assets/lp/arch-arrow.svg?raw";
import logoVertical from "../../public/logo/black/black_Navara_Vertical_logo_260819.svg?raw";

// Inline an arch SVG so the page CSS can re-theme its baked fills/strokes
// (an <img> would seal them off). The classes land on the <svg> itself, so
// the existing sizing rules keep applying to the same element they did as
// an <img>; the pieces are decorative, hence aria-hidden.
const archSvg = (raw: string, className: string): string =>
  raw.replace("<svg ", `<svg class="${className}" aria-hidden="true" `);

// Inline the brand logo (the black variant carries no fill attributes) so
// `fill: currentColor` lets CSS hand it the on-dark / on-band ink that
// matches whatever surface it sits on.
const logoSvg = (raw: string, className: string): string =>
  raw.replace("<svg ", `<svg class="${className}" role="img" aria-label="Navara" `);

interface Props {
  locale: string;
}

// The root locale is served at "/" without a path prefix (matches Starlight).
const ROOT_LOCALE = "en";

// Locales the docs site is built in (see astro.config.mjs `locales`). The LP
// can exist in more locales than the docs; LP-only locales link to the
// root-locale docs instead of a /docs/<locale>/ tree that doesn't exist.
const DOCS_LOCALES = new Set(["en", "ja"]);

const localeModules = import.meta.glob<{ default: any }>("../data/lp-locales/*.json", {
  eager: true,
});
const locales: Record<string, any> = {};
for (const [path, mod] of Object.entries(localeModules)) {
  const code = path.match(/([\w-]+)\.json$/)?.[1];
  if (code) locales[code] = mod.default;
}

const { locale } = Astro.props;
const t = locales[locale];
if (!t) throw new Error(`LP locale strings not found: ${locale}`);

// The docs deploy base ("/docs" on navara.world — see astro.config.mjs).
const DOCS_BASE = import.meta.env.BASE_URL.replace(/\/$/, "");

// Prefix docs-internal links with the deploy base and the locale path
// segment (root and LP-only locales have none). Site-root links (/examples)
// are used raw.
function localizeHref(href: string): string {
  if (!href.startsWith("/")) return href;
  const localeSeg = locale === ROOT_LOCALE || !DOCS_LOCALES.has(locale) ? "" : `/${locale}`;
  return `${DOCS_BASE}${localeSeg}${href}`;
}
const imageModules = import.meta.glob<{ default: ImageMetadata }>(
  [
    "../assets/**/*.{png,jpg,jpeg,gif,webp,avif,svg}",
    "../../../web/navara_three/example/public/screenshots/**/*.{png,jpg,jpeg,gif,webp,avif}",
  ],
  { eager: true },
);

interface ImageSlot {
  src: string | null;
  href?: string;
}

// Resolve a repo-root-relative path from lp.json to a bundled asset URL.
function resolveImage(imageSlot: ImageSlot): string | null {
  if (!imageSlot.src) return null;
  const key = imageSlot.src.startsWith("docs/src/")
    ? imageSlot.src.replace("docs/src/", "../")
    : `../../../${imageSlot.src}`;
  const mod = imageModules[key];
  if (!mod) throw new Error(`LP image not found: ${imageSlot.src}`);
  return mod.default.src;
}

const images = lp.images as Record<string, ImageSlot>;
const slot = (id: string): ImageSlot => {
  const s = images[id];
  if (!s) throw new Error(`LP image slot not defined in lp.json: ${id}`);
  return s;
};
const src = (id: string): string | null => resolveImage(slot(id));
// Alt text is copy, so it lives with the locale strings (imageAlts, keyed by slot id).
const alt = (id: string): string => {
  const text = t.imageAlts?.[id];
  if (text === undefined) throw new Error(`LP image alt not defined for locale "${locale}": ${id}`);
  return text;
};

const { colors, links } = lp;
const rootStyle = `--pri:${colors.primary};--pri-ink:${colors.primary};--acc:${colors.accent};--sub:${colors.sub};--ml:${colors.maplibre};--acc-hero:${colors.heroAccent};--mark-why:${colors.whyUnderline}`;

// Attribution credits (text + link to each source's terms). The strings are
// language-agnostic, so they live here rather than duplicated per locale; only
