    <script>
      // Theme preview: `?color` in the URL reveals the header switcher
      // (markup in LpHeader.astro, which also owns the language select);
      // picking a candidate rewrites the full --pri/--sub/--acc set on <html>
      // with the palette sheet's colors verbatim. Roles a candidate color
      // cannot fill without losing contrast fall back to the sheet's plain
      // black/white (its logo colors) instead of bending the palette:
      // a light primary keeps the bands but hands ink/scrims (--pri-ink) to
      // black and flips the band text (--on-band); a dark accent gets white
      // text (--on-acc). `?color=<variant name>` preselects that candidate.
      const colorSwitch = document.querySelector<HTMLElement>("[data-lp-color]");
      const colorSelect = colorSwitch?.querySelector<HTMLSelectElement>("select");
      const colorParam = new URLSearchParams(location.search).get("color");
      if (colorSwitch && colorSelect && colorParam !== null) {
        colorSwitch.hidden = false;
        // No showPicker() wiring here (unlike the language select): stacked
        // open-on-click handling can leave the dropdown eating the selection
        // until blur. The native mousedown behavior reacts immediately.
        if ([...colorSelect.options].some((o) => o.value === colorParam)) {
          colorSelect.value = colorParam;
        }
        // Relative luminance of a #rrggbb color.
        const lumOf = (hex: string): number => {
          const lin = (c: number) => {
            const s = c / 255;
            return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
          };
          return (
            0.2126 * lin(parseInt(hex.slice(1, 3), 16)) +
            0.7152 * lin(parseInt(hex.slice(3, 5), 16)) +
            0.0722 * lin(parseInt(hex.slice(5, 7), 16))
          );
        };
        const applyTheme = () => {
          const opt = colorSelect.selectedOptions[0];
          if (!opt) return;
          const pri = opt.dataset.pri ?? "";
          const acc = opt.dataset.acc ?? "";
          const root = document.documentElement.style;
          root.setProperty("--pri", pri);
          root.setProperty("--sub", opt.dataset.sub ?? "");
          root.setProperty("--acc", acc);
          const priDark = lumOf(pri) < 0.25;
          root.setProperty("--pri-ink", priDark ? pri : "#000000");
          if (priDark) {
            // Dark primary drives everything, like the shipped theme.
            root.removeProperty("--on-band");
            root.removeProperty("--on-band-soft");
          } else {
            root.setProperty("--on-band", "#000000");
            root.setProperty("--on-band-soft", "color-mix(in srgb, #000000 62%, transparent)");
          }
          if (lumOf(acc) < 0.3) {
            root.setProperty("--on-acc", "#ffffff");
          } else {
            root.removeProperty("--on-acc");
          }
          // The adaptive gallery inks compare against the (now changed) theme
          // ink; the resize path re-samples both the per-tile and side labels.
          window.dispatchEvent(new Event("resize"));
        };
        applyTheme();
        // `input` fires on selection itself; `change` covers browsers that
        // only commit on close/blur.
        colorSelect.addEventListener("input", applyTheme);
        colorSelect.addEventListener("change", applyTheme);
      }

      // Measure the catch-copy height so its sticky pin line sits exactly at
      // "fully revealed" (see .lp-intro's top calc).
      const stage = document.querySelector<HTMLElement>(".lp-hero-stage");
      const intro = document.querySelector<HTMLElement>(".lp-intro");
      if (stage && intro) {
        // Fractional height (not offsetHeight): a rounded value leaves a
        // sub-pixel hairline of hero video under the pinned panel.
        const setIntroHeight = () =>
          stage.style.setProperty("--lp-intro-h", `${intro.getBoundingClientRect().height}px`);
        setIntroHeight();
        window.addEventListener("resize", setIntroHeight);
        // Web fonts land after first paint and change the measured height,
        // which would leave a gap under the pinned panel — re-measure on any
        // reflow of the panel itself.
        new ResizeObserver(setIntroHeight).observe(intro);
      }

      // Scroll-linked fade for the catch-copy panel: it breathes in while it
      // rises over the hero, and once fully revealed it stays opaque — the
      // eased opacity rides the same scroll the slide does, so the two always
      // agree, and scrolling back up replays the fade in reverse.
      const heroPanel = document.querySelector<HTMLElement>(".lp-hero");
      if (
        stage &&
        intro &&
        heroPanel &&
        !matchMedia("(prefers-reduced-motion: reduce)").matches
      ) {
        // Cubic ease-in: stays faint for most of the travel, then surges to
        // full opacity near the end.
        const easeIn = (t: number) => t * t * t;
        let fadeQueued = false;
        const applyIntroFade = () => {
          fadeQueued = false;
          const vh = window.innerHeight;
          const y = window.scrollY;
          // Reveal: the panel's top travels from the viewport bottom up to
          // its pin line — one panel-height of scroll. Past that it holds at
          // full opacity for the rest of the page.
          const revealStart = heroPanel.offsetHeight - vh;
          const revealSpan = intro.offsetHeight;
          const t = (y - revealStart) / revealSpan;
          intro.style.opacity = String(easeIn(Math.min(1, Math.max(0, t))));
        };
        const queueIntroFade = () => {
          if (!fadeQueued) {
            fadeQueued = true;
            requestAnimationFrame(applyIntroFade);
          }
        };
        applyIntroFade();
        window.addEventListener("scroll", queueIntroFade, { passive: true });
        window.addEventListener("resize", queueIntroFade);
      }

      // The scroll cue has served its purpose once scrolling starts — fade it
      // out for good.
      const scrollCue = document.querySelector<HTMLElement>(".lp-hero-scroll-cue");
      if (scrollCue) {
        const dismissCue = () => {
          if (window.scrollY > 24) {
            scrollCue.classList.add("lp-cue-done");
            window.removeEventListener("scroll", dismissCue);
          }
        };
        window.addEventListener("scroll", dismissCue, { passive: true });
      }

      // The full-screen bands subtract the fixed header's height; publish the
      // real height (it varies with the breakpoint) so the last band ends
      // flush with the header when scrolled to the bottom.
      const headerEl = document.querySelector<HTMLElement>(".lp-header");
      if (headerEl) {
        const setHeaderHeight = () =>
          document.documentElement.style.setProperty(
            "--lp-header-h",
            `${headerEl.getBoundingClientRect().height}px`,
          );
        setHeaderHeight();
        new ResizeObserver(setHeaderHeight).observe(headerEl);
      }

      // Give the fixed header its light frosted backdrop (and ink chrome) as
      // soon as the intro panel scrolls up to meet it — from that line on the
      // header sits over light surfaces, never bare video. An observer on the
      // hero would flip too late: the intro's light glass slides under the
      // still-transparent header while the hero is partially on screen.
      const header = document.querySelector(".lp-header");
      if (header && intro) {
        let headerTicking = false;
        const updateHeaderSolid = () => {
          headerTicking = false;
          const h = header.getBoundingClientRect().height;
          header.classList.toggle("lp-header-solid", intro.getBoundingClientRect().top <= h);
        };
        const requestHeaderSolid = () => {
          if (!headerTicking) {
            headerTicking = true;
            requestAnimationFrame(updateHeaderSolid);
          }
        };
        window.addEventListener("scroll", requestHeaderSolid, { passive: true });
        window.addEventListener("resize", requestHeaderSolid);
        updateHeaderSolid();
      }

      // Crossfade the gallery overlay label as it crosses grid boundaries.
      // One observer per grid below the first; the deepest intersecting grid
      // wins (while the label sits over the showcase grid, the example grid
      // can still be partly on screen above it).
      const gallerySets = document.querySelectorAll<HTMLElement>(".lp-gallery-side-set");
      {
        const labelGrids: [string, Element | null][] = [
          ["example", document.querySelector(".lp-example-grid")],
          ["showcase", document.querySelector(".lp-showcase-grid")],
        ];
        const overGrid: Record<string, boolean> = {};
        const applyGallerySet = () => {
          const active = overGrid.showcase ? "showcase" : overGrid.example ? "example" : "tutorial";
          gallerySets.forEach((set) => {
            set.classList.toggle("lp-set-active", set.dataset.gallerySet === active);
          });
        };
        for (const [name, grid] of labelGrids) {
          if (!grid) continue;
          new IntersectionObserver(
            ([entry]) => {
              overGrid[name] = entry.isIntersecting;
              applyGallerySet();
            },
            // Shrink the viewport bottom to roughly the overlay label position,
            // so the swap happens as the label meets the grid's images.
            { rootMargin: "0px 0px -180px 0px" },
          ).observe(grid);
        }
      }

      // Adaptive gallery label ink: sample the luminance of the tile image
      // behind the sticky label and switch between white and the theme ink,
      // picking whichever has the higher WCAG contrast. This also covers
      // mid-gray backdrops, where neither pure inversion nor a fixed color
      // works well — the better of the two candidates always wins.
      const gallerySide = document.querySelector<HTMLElement>(".lp-gallery-side");
      const gallerySideInner = document.querySelector<HTMLElement>(".lp-gallery-side-inner");
      if (gallerySide && gallerySideInner) {
        // Linearize an sRGB channel (0-255) for relative-luminance math.
        const linear = (c: number): number => {
          const s = c / 255;
          return s <= 0.04045 ? s / 12.92 : ((s + 0.055) / 1.055) ** 2.4;
        };
        const contrast = (a: number, b: number): number =>
          (Math.max(a, b) + 0.05) / (Math.min(a, b) + 0.05);
        // Luminance of the theme ink (--pri-ink, always #rrggbb — set inline
        // from lp.json, or rewritten at runtime by the `?color` theme preview,
        // so it is read per sample rather than cached at load).
        const priLum = (): number => {
          const priHex = getComputedStyle(document.documentElement)
            .getPropertyValue("--pri-ink")
            .trim();
          return (
            0.2126 * linear(parseInt(priHex.slice(1, 3), 16)) +
            0.7152 * linear(parseInt(priHex.slice(3, 5), 16)) +
            0.0722 * linear(parseInt(priHex.slice(5, 7), 16))
          );
        };

        // Average luminance of the left quarter of the image's VISIBLE crop —
        // tiles render with object-fit: cover, so the displayed region must be
        // derived from the tile's aspect ratio before sampling. Sampled once
        // per image on a small canvas.
        const lumCache = new WeakMap<HTMLImageElement, number>();
        const luminanceOf = (img: HTMLImageElement): number | null => {
          const cached = lumCache.get(img);
          if (cached !== undefined) return cached;
          if (!img.complete || !img.naturalWidth) return null;
          const canvas = document.createElement("canvas");
          canvas.width = 12;
          canvas.height = 24;
          const ctx = canvas.getContext("2d", { willReadFrequently: true });
          if (!ctx) return null;
          // Source rect actually shown by object-fit: cover (centered crop).
          const scale = Math.max(
            img.clientWidth / img.naturalWidth,
            img.clientHeight / img.naturalHeight,
          );
          const visW = img.clientWidth / scale || img.naturalWidth;
          const visH = img.clientHeight / scale || img.naturalHeight;
          const sx = (img.naturalWidth - visW) / 2;
          const sy = (img.naturalHeight - visH) / 2;
          ctx.drawImage(img, sx, sy, visW / 4, visH, 0, 0, 12, 24);
          const data = ctx.getImageData(0, 0, 12, 24).data;
          let sum = 0;
          for (let i = 0; i < data.length; i += 4) {
            sum +=
              0.2126 * linear(data[i]) +
              0.7152 * linear(data[i + 1]) +
              0.0722 * linear(data[i + 2]);
          }
          const lum = sum / (data.length / 4);
          lumCache.set(img, lum);
          return lum;
        };

        // Per-tile attribution ink: sample the image pixels DIRECTLY UNDER the
        // info icon (top-right) and flip it to dark ink over light spots,
        // keeping white over dark — whichever contrasts better. Geometry is
        // measured relative to the cell (its reveal transform is a translate,
        // which cancels in the difference) and mapped through object-fit: cover.
        const lumUnder = (
          img: HTMLImageElement,
          cell: Element,
          el: Element,
        ): number | null => {
          if (!img.complete || !img.naturalWidth) return null;
          const cr = cell.getBoundingClientRect();
          const er = el.getBoundingClientRect();
          const cw = img.clientWidth || cr.width;
          const ch = img.clientHeight || cr.height;
          if (!cw || !ch) return null;
          const scale = Math.max(cw / img.naturalWidth, ch / img.naturalHeight);
          const visW = cw / scale;
          const visH = ch / scale;
          const cropX = (img.naturalWidth - visW) / 2;
          const cropY = (img.naturalHeight - visH) / 2;
          let sx = cropX + (er.left - cr.left) / scale;
          let sy = cropY + (er.top - cr.top) / scale;
          let sw = er.width / scale;
          let sh = er.height / scale;
          sx = Math.max(0, Math.min(sx, img.naturalWidth - 1));
          sy = Math.max(0, Math.min(sy, img.naturalHeight - 1));
          sw = Math.max(1, Math.min(sw, img.naturalWidth - sx));
          sh = Math.max(1, Math.min(sh, img.naturalHeight - sy));
          const canvas = document.createElement("canvas");
          canvas.width = 8;
          canvas.height = 8;
          const ctx = canvas.getContext("2d", { willReadFrequently: true });
          if (!ctx) return null;
          try {
            ctx.drawImage(img, sx, sy, sw, sh, 0, 0, 8, 8);
            const data = ctx.getImageData(0, 0, 8, 8).data;
            let sum = 0;
            for (let i = 0; i < data.length; i += 4) {
              sum +=
                0.2126 * linear(data[i]) +
                0.7152 * linear(data[i + 1]) +
                0.0722 * linear(data[i + 2]);
            }
            return sum / (data.length / 4);
          } catch {
            return null; // tainted canvas (cross-origin) — leave the default ink
          }
        };
        const sampleInk = (cell: Element) => {
          const img = cell.querySelector("img");
          const attr = cell.querySelector(".nv-attrib");
          const btn = cell.querySelector(".nv-attrib-btn");
          if (!img || !attr || !btn) return;
          const lum = lumUnder(img as HTMLImageElement, cell, btn);
          if (lum === null) return;
          attr.classList.toggle(
            "nv-attrib-ink-dark",
            contrast(priLum(), lum) > contrast(1, lum),
          );
        };
        // Sample when a tile is (near) on screen: by then its layout — and thus
        // the info button's position, which the sampled rect depends on — has
        // settled, avoiding an early read of stale geometry.
        const inkObserver = new IntersectionObserver(
          (entries) => {
            entries.forEach((e) => {
              if (!e.isIntersecting) return;
              const cell = e.target;
              const img = cell.querySelector("img") as HTMLImageElement | null;
              if (img && (!img.complete || !img.naturalWidth)) {
                img.addEventListener("load", () => sampleInk(cell), { once: true });
              } else {
                sampleInk(cell);
              }
              inkObserver.unobserve(cell);
            });
          },
          { rootMargin: "300px" },
        );
        const inkCells = document.querySelectorAll(".lp-tile-cell");
        inkCells.forEach((cell) => inkObserver.observe(cell));
        // The cover crop (and thus the sampled pixels) shifts with tile size.
        let inkResizeTimer = 0;
        window.addEventListener("resize", () => {
          clearTimeout(inkResizeTimer);
          inkResizeTimer = window.setTimeout(
            () => inkCells.forEach((cell) => sampleInk(cell)),
            150,
          );
        });

        let sideTicking = false;
        const updateSideInk = () => {
          sideTicking = false;
          const rect = gallerySideInner.getBoundingClientRect();
          if (rect.bottom < 0 || rect.top > window.innerHeight) return;
          const x = Math.max(1, Math.min(rect.left + rect.width / 2, window.innerWidth - 1));
          const y = Math.max(1, Math.min(rect.top + rect.height * 0.55, window.innerHeight - 1));
          const tile = document
            .elementsFromPoint(x, y)
            .find((el) => el.closest(".lp-tile"))
            ?.closest(".lp-tile");
          const img = tile?.querySelector("img");
          if (!img) return;
          const bg = luminanceOf(img);
          if (bg === null) return;
          gallerySide.classList.toggle("lp-side-dark", contrast(priLum(), bg) > contrast(1, bg));
        };
        const requestSideInk = () => {
          if (!sideTicking) {
            sideTicking = true;
            requestAnimationFrame(updateSideInk);
          }
        };
        window.addEventListener("scroll", requestSideInk, { passive: true });
        window.addEventListener("resize", requestSideInk);
        // The phone gallery scrolls horizontally inside its own container.
        document
          .querySelector(".lp-gallery-scroll")
          ?.addEventListener("scroll", requestSideInk, { passive: true });
        requestSideInk();

        // The label's start line: --side-h feeds the container's `top` calc
        // (see .lp-gallery-side) so the label's bottom first aligns just above
        // the first tile's bottom edge. The vertical-text height depends on
        // the font and wording, so it is measured — again once the webfont
        // lands, and on resize (the phone breakpoint changes the label size).
        const syncSideStart = () => {
          gallerySide.style.setProperty("--side-h", `${gallerySideInner.offsetHeight}px`);
        };
        syncSideStart();
        document.fonts?.ready.then(syncSideStart);
        window.addEventListener("resize", syncSideStart);
      }

      // Gallery tiles: open in a new tab, and reveal the example/tutorial name
      // (reused from the image alt) at the bottom-right on hover.
      document.querySelectorAll<HTMLAnchorElement>("a.lp-tile").forEach((tile) => {
        tile.target = "_blank";
        tile.rel = "noopener noreferrer";
        const img = tile.querySelector("img");
        if (!img || !img.alt) return;
        const label = document.createElement("span");
        label.className = "lp-tile-title";
        label.textContent = img.alt;
        tile.appendChild(label);
      });

      // Resolves once every <img> inside the element is loaded and decoded
      // (errors resolve too, so a broken image can never block an entrance).
      // Elements without images resolve immediately.
      const imagesReady = (el: Element): Promise<unknown> =>
        Promise.all(
          Array.from(el.querySelectorAll("img"), (img) => img.decode().catch(() => {})),
        );

      // Longest entrance: max stagger delay (0.75s) + slowest transition
      // (2.8s photo settle), rounded up. will-change promotion is released
      // after this so entrances never compete with each other for layers.
      const REVEAL_MS = 4000;

      // Promote everything an entrance animates onto its own compositor
      // layer for the duration of the transition, so a busy main thread
      // (image decode, layout) cannot freeze it mid-flight. The promotion
      // is temporary: keeping dozens of full-bleed layers alive would cost
      // more than it saves.
      const playReveal = (el: Element): void => {
        const layered = [el, ...el.children, ...el.querySelectorAll("img")] as HTMLElement[];
        layered.forEach((t) => (t.style.willChange = "opacity, transform"));
        // Two frames so the promotion is committed before the transition starts.
        requestAnimationFrame(() =>
          requestAnimationFrame(() => el.classList.add("lp-revealed")),
        );
        setTimeout(() => layered.forEach((t) => (t.style.willChange = "")), REVEAL_MS);
      };

      // Reveal-on-scroll: elements marked data-reveal (observed individually)
      // and data-reveal-group containers (which gate their staggered children)
      // play their entrance once they cross the lower edge of the viewport and
      // every image inside them is ready, so nothing fades in half-rendered.
      // Hidden states only exist under prefers-reduced-motion: no-preference,
      // so for reduced motion the class toggle is a no-op.
      const revealEls = document.querySelectorAll("[data-reveal], [data-reveal-group]");
      const revealObserver = new IntersectionObserver(
        (entries) => {
          for (const entry of entries) {
            if (entry.isIntersecting) {
              const el = entry.target;
              imagesReady(el).then(() => playReveal(el));
              revealObserver.unobserve(el);
            }
          }
        },
        { rootMargin: "0px 0px -10% 0px" },
      );
      revealEls.forEach((el) => revealObserver.observe(el));

      // Decode every landing-page image during idle time right after load, so
      // large decodes are spread out instead of bursting exactly when a
      // reveal (or a running entrance nearby) needs the main thread.
      const predecode = () =>
        document
          .querySelectorAll<HTMLImageElement>(".lp img")
          .forEach((img) => img.decode().catch(() => {}));
      "requestIdleCallback" in window
        ? requestIdleCallback(predecode, { timeout: 2000 })
        : setTimeout(predecode, 300);

      // API tier showcase: cross-fade the still through one scene per tier
      // and light the matching caption + ring label in sync. It auto-advances
      // while on screen (never under reduced motion); clicking a ring label
      // jumps to its tier and restarts the hold from there.
      const apiStage = document.querySelector<HTMLElement>(".lp-api-stage");
      if (apiStage) {
        const stills = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-media img"),
        );
        const caps = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-cap"),
        );
        const nodes = Array.from(
          apiStage.querySelectorAll<HTMLElement>(".lp-api-node"),
        );
        const reducedMotion = matchMedia("(prefers-reduced-motion: reduce)");
        const TIER_HOLD_MS = 3600;
        let tier = 0;
        let tierTimer: number | undefined;
        const showTier = (i: number) => {
          tier = i;
          stills.forEach((img, j) => img.classList.toggle("lp-tier-visible", j === i));
          caps.forEach((cap, j) => cap.classList.toggle("lp-tier-active", j === i));
          nodes.forEach((node) =>
            node.classList.toggle("lp-tier-active", Number(node.dataset.tier) === i),
          );
        };
        const stopTiers = () => {
          if (tierTimer !== undefined) {
            clearInterval(tierTimer);
            tierTimer = undefined;
          }
        };
        const startTiers = () => {
          if (tierTimer === undefined && !reducedMotion.matches) {
            tierTimer = window.setInterval(
              () => showTier((tier + 1) % stills.length),
              TIER_HOLD_MS,
            );
          }
        };
        new IntersectionObserver(
          ([entry]) => (entry.isIntersecting ? startTiers() : stopTiers()),
          { threshold: 0.35 },
        ).observe(apiStage);
        nodes.forEach((node) =>
          node.addEventListener("click", () => {
            showTier(Number(node.dataset.tier));
            stopTiers();
            startTiers();
          }),
        );
      }

      // Hero video: pick the phone or desktop encode, fade the (identical)
      // first frame in over the poster still, and only start the infinite
      // loop once that fade has finished — motion never happens on a
      // semi-transparent video ghosting against the static poster. Reduced
      // motion keeps the still.
      const heroEl = document.querySelector<HTMLElement>(".lp-hero");
      const heroVideo = document.querySelector<HTMLVideoElement>(".lp-hero-video");

      // Scene-synced video credits: show the attribution block whose scene is
      // under playback (boundaries in data-hero-scene-until, read off the
      // published cut). Past the last boundary — the loop-closing still is the
      // dive's first frame — wrap back to the first block.
      const sceneAttribs = [
        ...document.querySelectorAll<HTMLElement>("[data-hero-scene-until]"),
      ];
      if (heroVideo && sceneAttribs.length) {
        let activeScene = 0;
        heroVideo.addEventListener("timeupdate", () => {
          const t = heroVideo.currentTime;
          let next = sceneAttribs.findIndex(
            (el) => t < Number(el.dataset.heroSceneUntil),
          );
          if (next === -1) next = 0;
          if (next !== activeScene) {
            sceneAttribs[activeScene].hidden = true;
            sceneAttribs[next].hidden = false;
            activeScene = next;
          }
        });
      }

      // True from the priming pause until the post-fade restart has actually
      // resumed — the stopped-video watchdog below must not treat that
      // deliberate pause as a stall.
      let fadeRestartPending = false;
      if (heroEl && heroVideo) {
        if (window.matchMedia("(prefers-reduced-motion: no-preference)").matches) {
          const sp = window.matchMedia("(max-width: 640px)").matches;
          // Gating the fade on loadeddata does NOT work on iOS: Safari never
          // decodes a frame (loadeddata never fires) until playback starts.
          // So prime instead — start muted playback while the video is still
          // transparent, and on the first 'playing' (a frame is provably
          // rendering everywhere) pause, rewind to the poster frame, fade the
          // static frame in, and restart once the fade has finished. Motion
          // therefore never happens mid-fade on any platform.
          let primed = false;
          heroVideo.addEventListener("playing", () => {
            if (!primed) {
              primed = true;
              fadeRestartPending = true;
              heroVideo.pause();
              heroVideo.currentTime = 0;
              heroEl.classList.add("lp-video-live");
              let started = false;
              const start = () => {
                if (started) return;
                started = true;
                heroVideo
                  .play()
                  .then(() => (fadeRestartPending = false))
                  .catch(() => {
                    fadeRestartPending = false;
                    heroEl.classList.add("lp-video-blocked");
                  });
              };
              heroVideo.addEventListener("transitionend", start, { once: true });
              // Fallback in case transitionend never fires (display: none
              // ancestors, interrupted transitions).
              window.setTimeout(start, 1200);
              return;
            }
            // Not `once`: the blocked state can come back (e.g. the resume
            // after fullscreen is refused in Low Power Mode), so every
            // successful (re)start must clear it again.
            heroEl.classList.add("lp-video-live");
            heroEl.classList.remove("lp-video-blocked");
          });
          heroVideo.src = (sp ? heroVideo.dataset.srcSp : heroVideo.dataset.src) ?? "";
          // Autoplay can be refused (iOS Low Power Mode, browser policies);
          // that cannot be overridden, but a play() from a tap is still
          // allowed, so surface a play button as the fallback.
          heroVideo.play().catch(() => heroEl.classList.add("lp-video-blocked"));
          const playButton = document.querySelector<HTMLButtonElement>(".lp-hero-play");
          playButton?.addEventListener("click", () => heroVideo.play().catch(() => {}));
        }
        const fsButton = document.querySelector<HTMLButtonElement>(".lp-hero-fs");
        fsButton?.addEventListener("click", () => {
          // iOS Safari only offers the vendor call, and only on the element.
          const v = heroVideo as HTMLVideoElement & { webkitEnterFullscreen?: () => void };
          if (v.requestFullscreen) v.requestFullscreen().catch(() => {});
          else v.webkitEnterFullscreen?.();
        });
        // Leaving fullscreen pauses the video (iOS closes its native player
        // with a pause). Resuming right away races the player teardown —
        // WebKit can pause again AFTER our play() succeeded, which leaves the
        // video stopped without any rejection to react to. So: resume after a
        // beat, then verify playback actually stuck; if it did not (teardown
        // race, Low Power Mode refusal), surface the play button.
        const inNativeFullscreen = () => {
          const v = heroVideo as HTMLVideoElement & { webkitDisplayingFullscreen?: boolean };
          return Boolean(document.fullscreenElement) || Boolean(v.webkitDisplayingFullscreen);
        };
        const resume = () => {
          window.setTimeout(() => {
            if (heroVideo.paused && !inNativeFullscreen()) {
              heroVideo.play().catch(() => {});
            }
          }, 500);
          window.setTimeout(() => {
            if (heroVideo.paused && !inNativeFullscreen()) {
              heroEl.classList.add("lp-video-blocked");
            }
          }, 1000);
        };
        heroVideo.addEventListener("webkitendfullscreen", resume);
        document.addEventListener("fullscreenchange", () => {
          if (!document.fullscreenElement) resume();
        });
        // Catch-all: if the loop stops for any other reason while the page is
        // visible (tab restore, media-session interference), offer the button.
        heroVideo.addEventListener("pause", () => {
          window.setTimeout(() => {
            if (
              heroVideo.paused &&
              !fadeRestartPending &&
              !inNativeFullscreen() &&
              document.visibilityState === "visible"
            ) {
              heroEl.classList.add("lp-video-blocked");
            }
          }, 1500);
        });
        document.addEventListener("visibilitychange", () => {
          if (document.visibilityState === "visible" && heroVideo.paused) resume();
        });
      }

      // The hero opening also waits for its image, fading it in only once it
      // can be painted in full.
      const heroImg = document.querySelector<HTMLImageElement>(".lp-hero picture img");
      if (heroImg) {
        heroImg
          .decode()
          .catch(() => {})
          .then(() => {
            heroImg.style.willChange = "opacity, transform";
            heroImg.classList.add("lp-loaded");
            heroImg.addEventListener(
              "animationend",
              () => (heroImg.style.willChange = ""),
              { once: true },
            );
          });
      }
    </script>
    <noscript>
      <style>
        [data-reveal],
        [data-reveal-group] > * {
          opacity: 1 !important;
          transform: none !important;
        }
        [data-motion="img"] img {
          transform: none !important;
        }
        .lp-hero img {
          opacity: 1 !important;
        }
        .lp-hero-logo {
          opacity: 1 !important;
        }
      </style>
    </noscript>

    <style is:global>
      :root {
        /* Safe-area insets, named once so every edge-hugging rule reads the
           same (and so they can be simulated in a browser without a notch).
           Zero everywhere except on notched phones under viewport-fit=cover. */
        /* Not a theme color: matched to the baked glow-globe screenshot's
           own background (sampled pure black), so image and band are one. Also
           the canvas and browser-chrome tint — see body below. */
        --outro-bg: #000;
        --lp-safe-l: env(safe-area-inset-left, 0px);
        --lp-safe-r: env(safe-area-inset-right, 0px);
        --lp-safe-b: env(safe-area-inset-bottom, 0px);
        /* --pri-ink is the always-dark side of the theme: normally --pri
           itself (set inline with it), but the `?color` preview swaps it to
           plain black when a candidate palette's primary is light, so ink,
           hairlines and media scrims never go light. Bands keep --pri. */
        --ink: color-mix(in oklab, var(--pri-ink), black 20%);
        --ink-soft: color-mix(in oklab, var(--pri-ink), white 35%);
        /* Pure white per the design handoff — dark-band text no longer takes
           a primary tint. */
        --on-dark: #fff;
        /* Bright enough to read comfortably on the primary band — at lower
           white shares this went muddy gray against the navy. */
        --on-dark-soft: color-mix(in oklab, var(--pri-ink), white 85%);
        --line: color-mix(in oklab, var(--pri-ink), white 85%);
        --line-dark: color-mix(in oklab, var(--pri-ink), white 14%);
        /* Text on --pri-painted bands / on --acc surfaces. The preview flips
           these to the palette sheet's plain black or white when the band or
           accent color needs it; defaults reproduce the shipped theme. */
        --on-band: var(--on-dark);
        --on-band-soft: var(--on-dark-soft);
        --on-acc: var(--pri-ink);
      }
      html {
        scroll-behavior: smooth;
      }
      body {
        margin: 0;
        /* html has no background, so this color is propagated to the document
           canvas: it shows through the sub-pixel remainder at the page ends and
           during mobile overscroll, and iOS Safari tints its toolbars with it
           (see the theme-color meta, which pins the same value). The page can
           never *draw* under those toolbars, so matching the closing band's
           black is what makes it read as one surface at the bottom; the hero at
           the top is dark enough for the same color to disappear there. Every
           band paints its own background (.lp-main carries the light one). */
        background: var(--outro-bg);
        color: var(--ink);
        font-family: "Arsenal", "Zen Kaku Gothic New", sans-serif;
        -webkit-font-smoothing: antialiased;
      }
      .lp a {
        color: color-mix(in oklab, var(--acc), black 25%);
        text-decoration: none;
      }
      .lp a:hover {
        color: var(--acc);
      }
      /* Attribution credit links keep an underline — override the
         accent-coloured, underline-less default LP link style above. */
      .lp .nv-attrib-list a,
      .lp .nv-attrib-list a:hover {
        color: var(--on-dark);
        text-decoration: underline;
        text-underline-offset: 2px;
      }
      /* Attribution icons follow the LP's on-dark ink (the per-tile
         luminance flip to theme ink stays, its selector is more specific). */
      .lp .nv-attrib-btn {
        color: var(--on-dark);
      }
      /* Zero-specificity reset so per-section margin rules always win. */
      :where(.lp h1, .lp h2, .lp h3, .lp p) {
        margin: 0;
      }
      .lp img {
        display: block;
      }
      .lp-container {
        max-width: 1320px;
        margin: 0 auto;
        /* Landscape notch: content blocks step in, their section's full-bleed
           background stays edge to edge. */
        padding-left: var(--lp-safe-l);
        padding-right: var(--lp-safe-r);
      }

      /* Motion system — scroll-driven reveals.
         data-reveal: observed individually; data-reveal-group: the container
         is observed and its direct children stagger in DOM order. --rd is the
         stagger step (x 90ms), --rd-base shifts a whole group; both can be
         overridden inline for custom orders (e.g. the architecture diagram).
         data-motion variants: "img" = photo settle (frame fades, image scales
         down into place), "grow" = connectors growing upward. Everything is
         disabled under prefers-reduced-motion and, via <noscript>, without JS. */
      @media (prefers-reduced-motion: no-preference) {
        /* Page-load opening: the hero settles in, then the header drops in.
           The hero hides until JS marks its image as loaded (lp-loaded), so
           the fade always plays over the finished picture. The keyframes spell
           out the "to" state because the base state here is the hidden one. */
        @keyframes nv-hero-in {
          from {
            opacity: 0;
            transform: scale(1.045);
          }
          to {
            opacity: 1;
            transform: none;
          }
        }
        /* Scoped to the poster: other hero imgs (the attribution's Google
           logo) must stay visible. */
        .lp-hero picture img {
          opacity: 0;
        }
        .lp-hero picture img.lp-loaded {
          animation: nv-hero-in 3s cubic-bezier(0.3, 0.5, 0.2, 1) both;
        }
        @keyframes nv-header-in {
          from {
            opacity: 0;
            transform: translateY(-10px);
          }
        }
        .lp-header {
          animation: nv-header-in 1.6s 0.8s cubic-bezier(0.3, 0.5, 0.2, 1) both;
        }
        /* The centered lockup rides the poster's own entrance: hidden until
           JS marks the hero image decoded (lp-loaded), then the same 3s
           settle as nv-hero-in — the translate is repeated so the centering
           survives the animation, and only `from` is spelled out so the fill
           target stays whatever the cascade says (e.g. hidden while
           lp-video-blocked). The hidden state is scoped to the un-loaded
           hero for the same reason. */
        .lp-hero:not(:has(img.lp-loaded)) .lp-hero-logo {
          opacity: 0;
        }
        @keyframes nv-hero-logo-in {
          from {
            opacity: 0;
            transform: translate(-50%, -50%) scale(1.045);
          }
        }
        .lp-hero:has(img.lp-loaded) .lp-hero-logo {
          animation: nv-hero-logo-in 3s cubic-bezier(0.3, 0.5, 0.2, 1) both;
        }

        [data-reveal],
        [data-reveal-group] > * {
          opacity: 0;
          transform: translateY(22px);
          /* Soft, airy feel: a long fade on a gentle ease-out, with an even
             longer drift so elements seem to breathe into place. */
          transition:
            opacity 1.4s cubic-bezier(0.3, 0.5, 0.2, 1),
            transform 1.8s cubic-bezier(0.3, 0.5, 0.2, 1);
          transition-delay: calc((var(--rd-base, 0) + var(--rd, 0)) * 150ms);
        }
        /* DOM-order stagger inside groups. :nth-child(1) is explicit so a
           nested group's first child does not inherit its parent's --rd. */
        [data-reveal-group] > :nth-child(1) {
          --rd: 0;
        }
        [data-reveal-group] > :nth-child(2) {
          --rd: 1;
        }
        [data-reveal-group] > :nth-child(3) {
          --rd: 2;
        }
        [data-reveal-group] > :nth-child(4) {
          --rd: 3;
        }
        [data-reveal-group] > :nth-child(5) {
          --rd: 4;
        }
        [data-reveal-group] > :nth-child(6) {
          --rd: 5;
        }
        /* Photo settle: the frame only fades while the image scales down into
           place (tiles clip the overshoot via overflow: hidden). */
        [data-motion="img"] {
          transform: none;
        }
        .lp [data-motion="img"] img {
          transform: scale(1.05);
          transition:
            transform 2.8s cubic-bezier(0.3, 0.5, 0.2, 1),
            filter 0.35s ease;
          transition-delay: calc((var(--rd-base, 0) + var(--rd, 0)) * 150ms), 0s;
        }
        /* Connectors grow upward, matching the core-first build order. */
        [data-motion="grow"] {
          transform: scaleY(0);
          transform-origin: bottom;
        }
        /* Revealed states last, so they win the equal-specificity ties. */
        [data-reveal].lp-revealed,
        .lp-revealed[data-reveal-group] > * {
          opacity: 1;
          transform: none;
        }
        .lp-revealed[data-motion="img"] img,
        .lp-revealed[data-reveal-group] > [data-motion="img"] img {
          transform: none;
        }
      }

      /* Header styles live in LpHeader.astro (shared with the docs site);
         the nv-header-in drop-in above and the lp-header-solid frost toggled
         by the script below still target its classes. */
      /* Inline arrow icons sit on the text baseline row of their link. */      /* Inline arrow icons sit on the text baseline row of their link. */
      .lp .lp-getting-started a,
      .lp .lp-gallery-link a,
      .lp .lp-maplibre-roadmap a {
        display: inline-flex;
        align-items: center;
        gap: 3px;
      }
      .lp-link-icon {
        flex: none;
        /* Arsenal / Zen Kaku glyphs sit low in the em box; drop the icon to
           its optical center. */
        transform: translateY(1.5px);
      }
      /* Hero */
      .lp-hero-stage {
        position: relative;
      }
      /* Invisible scroll budget: while it is consumed, the hero and the
         fully revealed catch copy stay pinned, so the page appears to pause.
         Never shown as blank space — the pinned hero covers the viewport. */
      .lp-hero-stage::after {
        content: "";
        display: block;
        height: 40vh;
      }
      .lp-hero {
        /* Fill the first screen and stay pinned while the catch copy slides
           over it; the sticky range is bounded by .lp-hero-stage, so normal
           scrolling resumes once the catch copy is fully visible. */
        position: sticky;
        top: 0;
        /* Clips the oversized poster/video below (their baked credit band). */
        overflow: hidden;
        /* Mobile dynamic toolbars: `svh` is the viewport with the toolbars
           shown, `lvh` with them collapsed. The pinned hero has to cover the
           larger one — sized to svh, the first scroll (which the browser spends
           collapsing its toolbar) uncovers a strip of page background under the
           video. The bottom-anchored chrome below adds this difference back, so
           it stays inside the smaller, toolbar-shown viewport it is first seen
           in. */
        --lp-toolbar-h: calc(100lvh - 100svh);
        height: 100vh;
        height: 100lvh;
        min-height: 480px;
        /* Clip the opening animation's scale overshoot (nv-hero-in holds the
           poster at ~1.045 for 3s) — unclipped it widens the document's
           scrollable area, and Chromium keeps that stale horizontal scrollbar
           until the next relayout. */
        overflow: hidden;
        /* The section band is the theme primary (the alternating rhythm is
           PRI / SUB / PRI / SUB down the page); the promo video covers it,
           so it only peeks while the poster is still decoding. */
        background: var(--pri);
      }
      /* Poster + video only — the attribution overlay's logo img must not be
         stretched over the frame. */
      .lp-hero picture img,
      .lp-hero video {
        position: absolute;
        inset: 0;
        width: 100%;
        /* The bottom ~3.3% of every frame bakes the capture page's credit
           line (the LP overlays scene-synced credits instead, so it must
           never co-show). Oversizing the media past the container bottom
           makes the hero's overflow clip that band at EVERY aspect ratio —
           cover alone only crops vertically on wide windows. Same trick as
           .lp-hello-visual; fullscreen playback still shows the full frame,
           baked credits included. */
        height: 104.5%;
        /* Center crop: on phones the 16:9 frame is cut down to the portrait
           viewport around its middle (the fullscreen button shows it all). */
        object-fit: cover;
        object-position: center;
      }
      /* The video sits over the poster still and only fades in once playback
         has actually started, so the poster covers loading and autoplay
         refusals alike. */
      .lp-hero video {
        opacity: 0;
        transition: opacity 0.9s ease;
      }
      .lp-hero.lp-video-live video {
        opacity: 1;
      }
      /* Brand lockup pinned to the center of the hero video. The intro panel
         (z-index above the hero) slides over and hides it naturally; the
         header's own logo appears at that same scroll point. */
      .lp-hero-logo {
        position: absolute;
        left: 50%;
        /* A touch above true center — optically balanced against the catch
           copy rising from the bottom. */
        top: 43%;
        transform: translate(-50%, -50%);
        z-index: 1;
        width: clamp(225px, 30vw, 400px);
        height: auto;
        color: #fff;
        pointer-events: none;
        /* Soft scrim baked into the mark so it stays readable over the
           video's bright frames. */
        filter: drop-shadow(0 2px 20px color-mix(in srgb, #000 20%, transparent));
        transition: opacity 0.3s ease;
      }
      .lp-hero-logo path {
        fill: currentColor;
      }
      /* Autoplay refused: the centered play button needs the center — clear
         the lockup out from under it. */
      .lp-hero.lp-video-blocked .lp-hero-logo {
        opacity: 0;
      }
      .lp-hero-fs {
        display: none;
        position: absolute;
        right: 16px;
        bottom: calc(20px + var(--lp-toolbar-h, 0px) + var(--lp-safe-b));
        z-index: 2;
        width: 44px;
        height: 44px;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, #fff 35%, transparent);
        border-radius: 50%;
        background: color-mix(in srgb, var(--pri-ink) 45%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: var(--on-dark);
        cursor: pointer;
      }
      @media (max-width: 640px) {
        .lp-hero-fs {
          display: flex;
        }
      }
      /* Autoplay-refused fallback (iOS Low Power Mode etc.): a centered play
         button; a tap-initiated play() is allowed even when autoplay is not. */
      .lp-hero-play {
        display: none;
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        z-index: 2;
        width: 64px;
        height: 64px;
        align-items: center;
        justify-content: center;
        border: 1px solid color-mix(in srgb, #fff 35%, transparent);
        border-radius: 50%;
        background: color-mix(in srgb, var(--pri-ink) 45%, transparent);
        backdrop-filter: blur(8px);
        -webkit-backdrop-filter: blur(8px);
        color: var(--on-dark);
        cursor: pointer;
      }
      .lp-hero.lp-video-blocked .lp-hero-play {
        display: flex;
      }
      /* Phone-only scroll cue at the bottom center of the hero video. */
      .lp-hero-scroll-cue {
        display: none;
        position: absolute;
        left: 50%;
        bottom: calc(22px + var(--lp-toolbar-h, 0px) + var(--lp-safe-b));
        transform: translateX(-50%);
        z-index: 2;
        color: var(--on-dark);
        opacity: 0.85;
        transition: opacity 0.5s ease;
        pointer-events: none;
      }
      @media (max-width: 640px) {
        .lp-hero-scroll-cue {
          display: block;
        }
      }
      .lp-hero-scroll-cue.lp-cue-done {
        opacity: 0;
      }
      /* Video credits: the same quiet treatment as the API stills — bare
         light icon with a shadow. Bottom-anchored hero chrome, so it pays
         back the toolbar/safe-area offsets like the cue and fs button. */
      .lp-hero .lp-hero-attrib {
        z-index: 2;
        left: calc(16px + var(--lp-safe-l));
        bottom: calc(20px + var(--lp-toolbar-h, 0px) + var(--lp-safe-b));
      }
      .lp-hero-attrib .nv-attrib-btn,
      .lp-hero-attrib .nv-attrib-btn:hover {
        padding: 2px;
        background: none;
        box-shadow: none;
        backdrop-filter: none;
        color: var(--on-dark);
        filter: drop-shadow(0 1px 5px rgba(0, 0, 0, 0.65));
      }
      @media (prefers-reduced-motion: no-preference) {
        .lp-hero-scroll-cue svg {
          animation: lp-scroll-cue 2.2s ease-in-out infinite;
        }
      }
      @keyframes lp-scroll-cue {
        0%,
        55%,
        100% {
          transform: translateY(0);
          opacity: 1;
        }
        25% {
          transform: translateY(7px);
          opacity: 0.35;
        }
      }
      .lp-main {
        position: relative;
        z-index: 1;
        background: var(--sub);
      }

      /* Catch copy + intro: transparent, overlaid on the hero image. Pins
         via sticky exactly when fully revealed (top = viewport height minus
         its own height, measured by script) and stays pinned until the
         stage's scroll budget is used up. */
      .lp-intro {
        position: sticky;
        /* dvh, not svh: the pin line has to follow the *current* viewport, or
           the panel stops short of the bottom edge by the height of a
           collapsed mobile toolbar and leaves a strip of bare video under it.
           (lvh would be the mirror bug — cut off while the toolbar is out.) */
        top: calc(100vh - var(--lp-intro-h, 200vh));
        top: calc(100dvh - var(--lp-intro-h, 200dvh));
        z-index: 1;
        /* Pinned flush with the bottom of the viewport, so the bottom padding
           also has to clear the home indicator. */
        padding: 80px 48px calc(72px + var(--lp-safe-b));
        /* Frosted-glass panel over the hero image, in the theme primary: the
           page alternates PRI / SUB / PRI / SUB bands, and this glass is what
           the hero section reads as. Copy uses the on-band inks, which follow
           whether the primary is dark or light. */
        background: color-mix(in srgb, var(--pri) 60%, transparent);
        backdrop-filter: blur(14px);
        -webkit-backdrop-filter: blur(14px);
        /* The hero panel accents in the handoff's cream, not the global
           accent — scoped so the H1 span, CTAs and links inside follow. */
        --acc: var(--acc-hero);
      }
      .lp-intro-grid {
        display: grid;
        grid-template-columns: minmax(0, 11fr) minmax(0, 9fr);
        gap: 72px;
        align-items: start;
      }
      .lp-h1 {
        font: 700 68px/1.12 "Arsenal", "Zen Kaku Gothic New", sans-serif;
        letter-spacing: -0.01em;
        color: var(--on-band);
      }
      .lp-h1 span {
        color: var(--acc);
      }
      .lp-h1-sub {
        margin-top: 26px;
        font-size: 15px;
        color: var(--on-band-soft);
      }
      .lp-intro-right {
        padding-top: 8px;
      }
      .lp-intro-copy {
        font-size: 14.5px;
        line-height: 2;
        text-wrap: pretty;
        color: var(--on-band);
      }
      .lp-cta-row {
        display: flex;
        align-items: center;
        gap: 12px;
        margin-top: 34px;
        flex-wrap: wrap;
      }
      /* CTAs sit on the primary glass: the filled button inverts the band
         (on-band surface, primary text) and the outline draws in on-band, so
         both follow a dark or light primary. */
      .lp a.lp-btn-primary {
        background: var(--on-band);
        color: var(--pri);
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
      }
      .lp a.lp-btn-primary:hover {
        background: var(--acc);
        color: var(--on-acc);
      }
      .lp a.lp-btn-outline {
        border: 1.5px solid color-mix(in srgb, var(--on-band) 45%, transparent);
        color: var(--on-band);
        padding: 12px 24px;
        border-radius: 8px;
        font-weight: 700;
        font-size: 14px;
      }
      .lp a.lp-btn-outline:hover {
        border-color: var(--acc);
        color: var(--acc);
      }
      .lp-getting-started {
        margin-top: 18px;
        font-size: 13.5px;
        font-weight: 700;
      }
      .lp .lp-getting-started a {
        color: var(--acc);
      }
      .lp .lp-getting-started a:hover {
        color: var(--on-band);
      }

      /* Eyebrow labels */
      .lp-eyebrow {
        font: 500 13px "IBM Plex Mono", monospace;
        color: color-mix(in oklab, var(--acc), black 25%);
        letter-spacing: 0.12em;
      }
      .lp-eyebrow-center {
        text-align: center;
      }
      .lp-eyebrow-ml {
        color: color-mix(in oklab, var(--ml), white 65%);
      }
      .lp-h2 {
        margin: 10px 0 8px;
        font: 700 48px "Arsenal", "Zen Kaku Gothic New", sans-serif;
      }

      /* Why Navara */
      .lp-why {
        padding: 120px 48px 0;
        background: var(--sub);
        overflow-x: clip;
      }
      .lp-why-h2 {
        margin: 16px auto 0;
        font: 700 64px/1.35 "Arsenal", "Zen Kaku Gothic New", sans-serif;
        text-align: center;
      }
      .lp-why-h2 mark {
        color: inherit;
        background: linear-gradient(transparent 62%, var(--mark-why) 62%);
      }
      /* the four values are text-only — no rules, just columns and space,
         sitting close under the heading and close to the showcase below */
      .lp-values {
        display: grid;
        grid-template-columns: repeat(4, 1fr);
        column-gap: 40px;
        margin-top: 56px;
      }
      .lp-values h3 {
        font-size: 19px;
      }
      .lp-values p {
        margin-top: 10px;
        font-size: 13px;
        line-height: 1.95;
        color: var(--ink-soft);
      }
      /* API tiers: media showcase. The stage cross-fades one still per tier
         while the list beside it highlights in sync (driven by the script;
         without JS the first still stays up and the list reads normally). */
      .lp-api-tiers {
        margin-top: 44px;
      }
      /* catchphrase, overlaid top-left */
      .lp-api-lede {
        position: absolute;
        z-index: 2;
        top: 0;
        left: 0;
        max-width: 760px;
        padding: clamp(26px, 4vw, 68px) clamp(28px, 5vw, 100px) 0;
      }
      .lp-api-lede-title {
        margin: 0;
        color: var(--on-dark);
        font-size: clamp(30px, 4vw, 52px);
        line-height: 1.18;
        font-weight: 680;
        letter-spacing: -0.01em;
        text-wrap: balance;
      }
      .lp-api-lede-sub {
        margin: 12px 0 0;
        color: rgba(255, 255, 255, 0.84);
        font-size: clamp(14px, 1.2vw, 17px);
        line-height: 1.6;
      }
      /* full-bleed band: break out of the container to the viewport edges,
         capped to roughly the window height so it never runs too tall */
      .lp-api-media {
        position: relative;
        aspect-ratio: 16 / 9;
        max-height: 95vh;
        overflow: hidden;
        background: color-mix(in oklab, var(--pri), white 90%);
        width: 100vw;
        margin-left: calc(50% - 50vw);
        border-radius: 0;
      }
      .lp-api-media img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        /* bias the cover-crop toward the top so more sky shows */
        object-position: center 28%;
        opacity: 0;
        transition: opacity 0.9s ease;
      }
      .lp-api-media img.lp-tier-visible {
        opacity: 1;
      }
      /* attribution: no background, white icon with a shadow, tucked into
         the top-right corner */
      .lp-api-media .nv-attrib-tr {
        top: clamp(12px, 1.6vw, 24px);
        right: clamp(12px, 1.6vw, 24px);
      }
      .lp-api-media .nv-attrib-btn,
      .lp-api-media .nv-attrib-btn:hover {
        padding: 2px;
        background: none;
        color: var(--on-dark);
        box-shadow: none;
        backdrop-filter: none;
        filter: drop-shadow(0 1px 5px rgba(0, 0, 0, 0.65));
      }
      .lp-api-media .nv-attrib-btn svg {
        width: 19px;
        height: 19px;
      }

      /* per-tier caption, overlaid bottom-left; stacked so swaps never shift */
      .lp-api-caps {
        position: absolute;
        z-index: 2;
        left: 0;
        bottom: 0;
        max-width: 680px;
        padding: 0 clamp(28px, 5vw, 100px) 40px;
        display: grid;
      }
      .lp-api-cap {
        grid-area: 1 / 1;
        opacity: 0;
        transform: translateY(6px);
        transition:
          opacity 0.6s ease,
          transform 0.6s ease;
      }
      .lp-api-cap.lp-tier-active {
        opacity: 1;
        transform: none;
      }
      .lp-api-cap-title {
        margin: 0;
        color: var(--on-dark);
        font-size: 23px;
        font-weight: 660;
        letter-spacing: 0.02em;
      }
      .lp-api-cap-scene {
        font-size: 14px;
        font-weight: 500;
        color: rgba(255, 255, 255, 0.58);
        margin-left: 12px;
        letter-spacing: 0;
      }
      .lp-api-cap-desc {
        margin: 10px 0 0;
        color: rgba(255, 255, 255, 0.9);
        font-size: 16.5px;
        line-height: 1.6;
      }
      /* editorial open ring, bottom-right; geometry authored at 240px */
      .lp-api-ring {
        position: absolute;
        z-index: 3;
        /* the drawn circle sits ~27px inside the wrap (24px * scale), so
           subtract that so its right/bottom gap matches the left text margin
           (horizontal clamp(28,5vw,100) and the caption's 40px bottom) */
        right: calc(clamp(28px, 5vw, 100px) - 32px);
        bottom: 8px;
        width: 240px;
        height: 240px;
        transform: scale(1.32);
        transform-origin: bottom right;
      }
      .lp-api-ring svg {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        overflow: visible;
      }
      /* larger ring, but kept quiet: a thinner, dimmer track so the bigger
         size reads as spacious rather than loud */
      .lp-api-track {
        fill: none;
        stroke: rgba(255, 255, 255, 0.42);
        stroke-width: 1.1;
        stroke-linecap: round;
      }
      .lp-api-node {
        position: absolute;
        z-index: 4;
        border: 0;
        background: none;
        padding: 6px 8px;
        cursor: pointer;
        font: inherit;
        white-space: nowrap;
      }
      .lp-api-node span {
        display: block;
        font-size: 16px;
        font-weight: 560;
        color: rgba(255, 255, 255, 0.6);
        transition:
          color 0.3s ease,
          text-shadow 0.5s ease;
      }
      /* hover cue so it reads as clickable (pointer devices only) */
      @media (hover: hover) {
        .lp-api-node:hover span {
          color: var(--on-dark);
        }
      }
      /* The active label keeps its accent glow — a design element, not a
         readability shadow. */
      .lp-api-node.lp-tier-active span {
        color: var(--on-dark);
        font-weight: 640;
        text-shadow:
          0 0 7px var(--acc),
          0 0 16px var(--acc),
          0 0 30px color-mix(in oklab, var(--acc), transparent 35%),
          0 0 48px color-mix(in oklab, var(--acc), transparent 60%);
      }
      .lp-api-node:focus-visible {
        outline: 2px solid var(--acc);
        outline-offset: 2px;
        border-radius: 6px;
      }
      .lp-node-dec {
        left: 120px;
        top: 120px;
        transform: translate(-50%, -50%);
        z-index: 5;
      }
      .lp-node-plugin {
        left: 120px;
        top: 24px;
        transform: translate(-50%, -50%);
      }
      .lp-node-api {
        left: 193.5px;
        top: 181.7px;
        transform: translate(-50%, -50%);
      }
      .lp-node-shader {
        left: 46.5px;
        top: 181.7px;
        transform: translate(-50%, -50%);
      }

      /* Hello world: the whole first program beside its rendered result, on
         a light band — the dark code card carries the contrast. */
      .lp-hello {
        /* One screen tall (minus the 68px fixed header): real height with
           the content self-centering, not padding. */
        display: flex;
        flex-direction: column;
        justify-content: center;
        box-sizing: border-box;
        min-height: calc(100svh - var(--lp-header-h, 68px));
        padding: 96px 48px;
        background: var(--sub);
        color: var(--ink);
      }
      /* The code card drives the row height; the visual fills the remaining
         height of the side column (copy + CTA keep their natural size), so
         the image bottom lines up with the code card no matter how long the
         snippet is. */
      .lp-hello-grid {
        display: grid;
        grid-template-columns: minmax(0, 9fr) minmax(0, 11fr);
        gap: 56px;
        align-items: stretch;
        margin-top: 44px;
      }
      .lp-hello-side {
        display: flex;
        flex-direction: column;
      }
      /* The code card is the section's visual anchor: the hero's dark ink as
         a panel, with the Shiki css-variables theme mapped onto the LP
         palette so a theme change in lp.json restyles the code too. */
      .lp-hello-code {
        border-radius: 14px;
        /* Always a dark editor panel (--pri-ink stays dark whatever the band
           color), a step lighter than pure ink with a hairline. */
        background: color-mix(in oklab, var(--pri-ink), white 4%);
        border: 1px solid color-mix(in srgb, #fff 10%, transparent);
        --astro-code-background: transparent;
        --astro-code-foreground: var(--on-dark);
        --astro-code-color-background: transparent;
        --astro-code-color-text: var(--on-dark);
        --astro-code-token-keyword: color-mix(in oklab, var(--acc), white 20%);
        --astro-code-token-function: color-mix(in oklab, var(--acc), white 40%);
        --astro-code-token-string: color-mix(in oklab, var(--acc), white 60%);
        --astro-code-token-string-expression: color-mix(in oklab, var(--acc), white 60%);
        --astro-code-token-constant: var(--on-dark);
        --astro-code-token-parameter: var(--on-dark-soft);
        --astro-code-token-punctuation: var(--on-dark-soft);
        --astro-code-token-comment: color-mix(in srgb, var(--on-dark) 45%, transparent);
        --astro-code-token-link: color-mix(in oklab, var(--acc), white 20%);
      }
      .lp-hello-code pre {
        margin: 0;
        padding: 26px 30px;
        overflow-x: auto;
        border-radius: inherit;
        font-size: 12.5px;
        line-height: 1.8;
      }
      .lp-hello-code code {
        font-family: "IBM Plex Mono", monospace;
      }
      .lp-hello-visual {
        position: relative;
        flex: 1;
        min-height: 0;
        border-radius: 14px;
        border: 1px solid color-mix(in srgb, var(--ink) 14%, transparent);
        overflow: hidden;
      }
      .lp-hello-visual img {
        width: 100%;
        /* The still bakes the example's own attribution button into its
           bottom-right corner, and the LP overlays its own credit there.
           Oversize the image so the frame clips that bottom band away at every
           aspect ratio (16/9 on phones leaves no crop of its own). */
        height: 106%;
        object-fit: cover;
      }
      /* Overlaid on the image, opposite the attribution icon. */
      .lp-hello-cta {
        position: absolute;
        left: 22px;
        bottom: 16px;
        z-index: 1;
        font-size: 13.5px;
        font-weight: 700;
      }
      .lp .lp-hello-cta a {
        color: var(--acc);
      }
      .lp .lp-hello-cta a:hover {
        color: var(--on-dark);
      }

      /* Architecture: primary band between the light hello band and the
         black gallery. */
      .lp-arch {
        padding: 120px 48px;
        background: var(--pri);
        color: var(--on-band);
        text-align: center;
      }
      .lp-arch .lp-eyebrow {
        color: var(--acc);
      }
      .lp-arch .lp-h2 mark {
        /* No highlighter here (unlike .lp-why-h2 mark) — just neutralise the
           browser's default yellow mark so the phrase reads as plain text. */
        color: inherit;
        background: none;
      }
      /* Diagram composed from the arch-* line-art SVGs. Two grid rows: a shared
         head row (titles) and a fixed-height body row (source pieces → arrows →
         globe). Isolating the bodies in one aligned row keeps the arrow
         convergence, the globe center and the middle source piece on one line,
         no matter how many lines each title wraps to. The arch-* strokes are
         re-inked to the on-band white below, so this reads as clean line art
         on the primary band. */
      .lp-arch-flow {
        --arch-body-h: clamp(320px, 36vw, 400px);
        display: grid;
        grid-template-columns: minmax(0, 1fr) minmax(120px, 0.86fr) minmax(0, 1.3fr);
        grid-template-rows: auto var(--arch-body-h);
        grid-template-areas:
          "shead .      rhead"
          "sbody arrows rbody";
        column-gap: clamp(8px, 3vw, 48px);
        row-gap: clamp(18px, 2.6vw, 34px);
        width: min(1060px, 100%);
        margin: clamp(36px, 6vw, 72px) auto 0;
        color: var(--on-band);
      }
      /* Titles sit at the bottom of the head row, just above their body. */
      .lp-arch-head {
        align-self: end;
        text-align: center;
      }
      .lp-arch-head.is-source {
        grid-area: shead;
      }
      .lp-arch-head.is-render {
        grid-area: rhead;
      }
      /* Node titles: deliberately larger than the original baked diagram so
         they carry weight within the LP's type scale. */
      .lp-arch-node-title {
        margin: 0;
        font-size: clamp(22px, 2.6vw, 34px);
        font-weight: 680;
        letter-spacing: -0.01em;
        line-height: 1.2;
        text-wrap: balance;
      }
      .lp-arch-node-sub {
        margin: 10px 0 0;
        font-size: clamp(13px, 1.1vw, 15px);
        line-height: 1.55;
        color: var(--on-band-soft);
        text-wrap: balance;
      }
      .lp-arch-body {
        min-width: 0;
      }
      .lp-arch-body.is-source {
        grid-area: sbody;
      }
      .lp-arch-body.is-arrows {
        grid-area: arrows;
      }
      .lp-arch-body.is-render {
        grid-area: rbody;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      /* Source pieces in three equal-height slots; each piece is centered in
         its slot, so their centers fall exactly on the arrow origins. */
      .lp-arch-stack {
        display: flex;
        flex-direction: column;
        height: 100%;
      }
      .lp-arch-slot {
        flex: 1 1 0;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .lp-arch-piece {
        display: block;
        height: auto;
      }
      .lp-arch-p-terrain {
        width: clamp(150px, 20vw, 220px);
      }
      .lp-arch-p-marker {
        width: clamp(30px, 3.4vw, 42px);
      }
      .lp-arch-p-buildings {
        width: clamp(120px, 15vw, 168px);
      }
      /* Converging arrows (arch-arrow.svg). The asset's three sources sit at
         the top / middle / bottom edges of its box; sizing it to 2/3 of the
         body height and centering it maps those onto the source pieces' centers
         (1/6, 1/2, 5/6) while its arrowhead stays on the row's midline — the
         globe center. */
      .lp-arch-arrows {
        display: flex;
        align-items: center;
        justify-content: center;
      }
      .lp-arch-arrow-img {
        display: block;
        height: 66.666%;
        width: auto;
        max-width: 100%;
      }
      /* Rendered globe with the same three pieces composited inside it. Square,
         sized to the body row height (or the cell width when narrower) and
         centered — so its center stays on the row's vertical midline. */
      .lp-arch-globe {
        position: relative;
        width: min(100%, var(--arch-body-h));
        aspect-ratio: 1 / 1;
      }
      .lp-arch-globe-base {
        display: block;
        width: 100%;
        height: 100%;
      }
      /* Re-theme the inlined arch line-art: CSS outranks the SVGs' baked
         presentation attributes, so their fixed light-band palette (fills
         matching the band, ink strokes, gray graticule) is inverted for the
         primary band: fills become the band color (cutouts), strokes/solid
         fills the on-band white, the graticule a lighter primary tint. */
      .lp-arch-flow svg [fill="#F4F3EF"] {
        fill: var(--pri);
      }
      .lp-arch-flow svg [stroke="#090C11"] {
        stroke: var(--on-band);
      }
      .lp-arch-flow svg [fill="#090C11"] {
        fill: var(--on-band);
      }
      .lp-arch-flow svg [stroke="#C9C9C9"] {
        stroke: color-mix(in oklab, var(--pri), white 35%);
      }

      /* Gallery — seamless image strip on black; the section title floats
         over the first tile. */
      .lp-gallery {
        background: #000;
      }
      .lp-gallery-head {
        position: absolute;
        top: 0;
        left: 0;
        right: 0;
        z-index: 2;
        padding: 44px 48px 96px;
        color: var(--on-dark);
        /* Top scrim so the title reads over any screenshot; clicks pass
           through to the tile underneath. */
        background: linear-gradient(color-mix(in srgb, black 55%, transparent), transparent);
        pointer-events: none;
      }
      .lp-gallery-head .lp-eyebrow {
        color: var(--acc);
      }
      /* Full-bleed image strip with a single overlay label spanning both the
         tutorial and example grids. */
      .lp-gallery-strip {
        position: relative;
      }
      /* The label ink adapts to the tile behind it: a script samples the
         backdrop image's luminance and toggles lp-side-dark to whichever of
         white / theme ink has the higher WCAG contrast (difference blending
         was dropped — it produces mid-gray on mid-gray backdrops). */
      .lp-gallery-side {
        position: absolute;
        /* The sticky label is clamped to this container: its top starts one
           label-height (--side-h, measured by script — vertical text, so it
           depends on font and wording) above the first tile's bottom edge, so
           the label first appears with its BOTTOM on that edge and can never
           ride above it. The tile term must stay in sync with .lp-tile-wide's
           height at each breakpoint. */
        top: calc(min(48vw, 780px) - var(--side-h, 320px) - 44px);
        bottom: 0;
        left: 0;
        z-index: 2;
        display: flex;
        flex-direction: column;
        justify-content: flex-end;
        pointer-events: none;
      }
      .lp-gallery-side-inner {
        position: sticky;
        bottom: 44px;
        margin: 0 0 44px 40px;
        display: grid;
      }
      /* Both label sets are stacked in the same cell and crossfade when the
         overlay crosses into the example grid. */
      .lp-gallery-side-set {
        grid-area: 1 / 1;
        /* Bottom-align both sets so "See more" (and its distance to the screen
           edge) stays put regardless of the vertical label's length — only the
           taller label extends further up. */
        align-self: end;
        opacity: 0;
        transition: opacity 0.35s ease;
        pointer-events: none;
      }
      /* The whole overlay is click-transparent (no links inside since the
         "See more" line was dropped) — clicks land on the tile underneath. */
      .lp-gallery-side-set.lp-set-active {
        opacity: 1;
      }
      .lp-gallery-label {
        /* Fluid with the viewport (≈32px on desktop, floors at 20px on
           phones); --side-h is re-measured on resize, so the label's start
           alignment follows the size. */
        font: 700 clamp(20px, 2.4vw, 32px) "IBM Plex Mono", monospace;
        letter-spacing: 0.34em;
        writing-mode: vertical-rl;
        color: var(--on-dark);
        transition: color 0.4s ease;
      }
      .lp-gallery-side.lp-side-dark .lp-gallery-label {
        color: var(--pri-ink);
      }
      .lp-tutorial-grid {
        display: grid;
        grid-template-columns: 1fr 1fr;
      }
      /* Showcase grid — square tiles continuing the strip, three per row. */
      .lp-showcase-grid {
        display: grid;
        grid-template-columns: repeat(3, 1fr);
      }
      .lp-tile-sq {
        aspect-ratio: 1;
      }
      /* Grid item wrapping each tile: carries the column-span / height classes
         and hosts the per-tile attribution overlay (a sibling of the link, so
         the info button is never nested inside the tile's <a>). */
      .lp-tile-cell {
        position: relative;
      }
      /* A hovered cell outranks its sibling tiles (while the reveal fade is
         running the cell's opacity is < 1, making it a stacking context that
         the next tile in DOM order would paint over) — but stays under the
         gallery's overlay labels (z-index 2). */
      .lp-tile-cell:hover {
        z-index: 1;
      }
      /* Only while the attribution tooltip is showing (pinned, hovered, or
         keyboard-focused) does the cell outrank the labels as well, so the
         tooltip is never clipped by them. */
      .lp-tile-cell:has(.nv-attrib-open),
      .lp-tile-cell:has(.nv-attrib:hover),
      .lp-tile-cell:has(:focus-visible) {
        z-index: 3;
      }
      .lp-tile {
        position: relative;
        display: block;
        overflow: hidden;
        height: 100%;
      }
      .lp-tile img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
      }
      /* Per-tile attribution: top-right (bottom-right would collide with the
         on-hover title). 10px inset gives the Google logo its required top/right
         clear space. No plate — a white icon + shadow reads on any screenshot. */
      .lp-tile-attrib.nv-attrib-tr {
        top: 10px;
        right: 10px;
      }
      .lp-tile-attrib .nv-attrib-btn,
      .lp-tile-attrib .nv-attrib-btn:hover {
        padding: 2px;
        background: none;
        box-shadow: none;
        backdrop-filter: none;
        filter: none;
        color: var(--on-dark);
      }
      /* Over light imagery, flip to dark theme ink (the class is toggled per
         tile by the top-right luminance sampler). */
      .lp-tile-attrib.nv-attrib-ink-dark .nv-attrib-btn,
      .lp-tile-attrib.nv-attrib-ink-dark .nv-attrib-btn:hover {
        color: var(--pri-ink);
      }
      /* Hover lift on linked tiles (the reveal transition keeps transform,
         so hover only touches filter to stay snappy). */
      a.lp-tile {
        cursor: pointer;
      }
      /* The `.lp` prefix lifts specificity above the reveal system's
         `.lp [data-motion="img"] img` rule (which otherwise forces its 2.8s
         entrance-settle transition onto hover too). */
      .lp a.lp-tile img {
        transition:
          filter 0.8s ease,
          transform 0.8s cubic-bezier(0.2, 0.7, 0.2, 1);
      }
      .lp a.lp-tile:hover img,
      .lp a.lp-tile:focus-visible img {
        filter: brightness(1.1);
        transform: scale(1.04);
      }
      /* On hover, reveal the example/tutorial name flush in the bottom-right
         corner — always white text on a black plate that meets the tile edges
         (no inset), for consistent legibility over any screenshot. */
      .lp-tile-title {
        position: absolute;
        right: 0;
        bottom: 0;
        z-index: 1;
        max-width: min(100%, 24em);
        text-align: right;
        margin: 0;
        padding: 7px 12px;
        font-size: clamp(13px, 1vw, 16px);
        font-weight: 600;
        line-height: 1.32;
        letter-spacing: 0.01em;
        text-wrap: balance;
        color: var(--on-dark);
        background: rgba(0, 0, 0, 0.72);
        opacity: 0;
        transform: translateY(6px);
        transition:
          opacity 0.24s ease,
          transform 0.24s cubic-bezier(0.2, 0.7, 0.2, 1);
        pointer-events: none;
      }
      a.lp-tile:hover .lp-tile-title,
      a.lp-tile:focus-visible .lp-tile-title {
        opacity: 1;
        transform: translateY(0);
      }
      @media (prefers-reduced-motion: reduce) {
        .lp a.lp-tile:hover img,
        .lp a.lp-tile:focus-visible img {
          transform: none;
        }
        .lp-tile-title {
          transition: opacity 0.24s ease;
          transform: none;
        }
        a.lp-tile:hover .lp-tile-title,
        a.lp-tile:focus-visible .lp-tile-title {
          transform: none;
        }
      }
      .lp-tile-wide {
        grid-column: span 2;
        height: min(48vw, 780px);
      }
      .lp-tile-half {
        height: min(34vw, 560px);
      }
      /* 60-column grid so rows can mix 3:2 (36+24), 1:1:1 (20+20+20),
         2:3 (24+36), and 1:1:1:1 (15x4) — one distinct split per row. */
      .lp-example-grid {
        display: grid;
        grid-template-columns: repeat(60, 1fr);
        grid-auto-rows: min(36vw, 600px);
      }
      .lp-span-15 {
        grid-column: span 15;
      }
      .lp-span-20 {
        grid-column: span 20;
      }
      .lp-span-24 {
        grid-column: span 24;
      }
      .lp-span-36 {
        grid-column: span 36;
      }

      /* Showcases — a full-bleed, gapless strip of site screenshots that
         auto-scrolls sideways. Two identical rows sit side by side in the
         track and the loop slides the track exactly one row-width
         (translateX(-50%)), so the film reads as endless. The tiles are
         links, so hover (and keyboard focus inside) pauses the ride; under
         reduced motion the clone row is dropped and the strip becomes a
         plain manual scroller. White on purpose (not --sub): the strip sits
         between two black bands and the screenshots supply the color. */
      /* MapLibre family */
      .lp-maplibre {
        padding: 120px 48px;
        background: var(--ml);
        color: #fff;
      }
      .lp-maplibre-grid {
        display: grid;
        grid-template-columns: minmax(0, 6fr) minmax(0, 5fr);
        gap: 80px;
        align-items: center;
      }
      .lp-maplibre-brand {
        display: flex;
        align-items: center;
        gap: 12px;
      }
      .lp-maplibre-logo {
        width: 40px;
        height: 40px;
        flex: none;
      }
      .lp-maplibre-logo-placeholder {
        border: 1px dashed color-mix(in oklab, var(--ml), white 40%);
        border-radius: 8px;
        box-sizing: border-box;
      }
      .lp-maplibre-h2 {
        margin: 14px 0 24px;
        font: 700 48px "Arsenal", "Zen Kaku Gothic New", sans-serif;
      }
      .lp-maplibre-copy {
        margin-bottom: 36px;
        font-size: 15px;
        line-height: 2;
        color: color-mix(in oklab, var(--ml), white 80%);
        text-wrap: pretty;
      }
      .lp-maplibre-list {
        margin: 0;
        padding: 0;
        list-style: none;
        display: flex;
        flex-direction: column;
        gap: 16px;
        font-size: 14px;
      }
      .lp-maplibre-list li {
        display: flex;
        gap: 10px;
      }
      .lp-maplibre-list li .lp-maplibre-check {
        flex: 0 0 auto;
        margin-top: 3px;
        color: color-mix(in oklab, var(--ml), white 60%);
      }
      .lp-maplibre-roadmap {
        margin-top: 32px;
        font-size: 13px;
      }
      .lp .lp-maplibre-roadmap a {
        color: #fff;
        text-decoration: underline;
      }
      .lp .lp-maplibre-roadmap a:hover {
        color: color-mix(in oklab, var(--ml), white 70%);
      }
      .lp-maplibre-visual {
        position: relative;
        min-height: 560px;
        /* Clip the reveal scale-settle to the rounded frame. */
        overflow: hidden;
        border-radius: 14px;
      }
      .lp-maplibre-visual img {
        position: absolute;
        inset: 0;
        width: 100%;
        height: 100%;
        object-fit: cover;
        border-radius: 14px;
      }
      /* No plate; theme ink reads on the light basemap still. This section has
         no luminance sampler, so the ink is fixed (the still is always light). */
      .lp-maplibre-visual .nv-attrib-btn,
      .lp-maplibre-visual .nv-attrib-btn:hover {
        background: none;
        box-shadow: none;
        backdrop-filter: none;
        color: var(--pri-ink);
      }

      /* Get started (footer) */
      /* Closing call to action: a roomy band of its own, with the glow-globe
         example still behind it; the scrim dims it for contrast and fades its
         edges into the band. The hairline on the footer below keeps the two
         from reading as one block. */
      /* The closing band: one canvas holding the outro CTA and the footer,
         with the glow-globe still spanning both. */
      .lp-close {
        position: relative;
        overflow: hidden;
        background: var(--outro-bg);
      }
      /* The footer is lifted out of flow (absolute, bottom) so the band's
         height — and the image and vignette centered in it — is set by the
         outro alone. One screen tall (minus the 68px fixed header), with the
         content flex-centered; the symmetric padding keeps it clear of the
         overlaid footer on short viewports. */
      .lp-outro {
        position: relative;
        display: flex;
        align-items: center;
        justify-content: center;
        box-sizing: border-box;
        min-height: calc(100svh - var(--lp-header-h, 68px));
        padding: 150px 48px;
        text-align: center;
      }
      /* Height-driven sizing: the still is always 115% of the band's height
         (its globe fills ~95% of the frame, so it slightly overflows top and
         bottom), centered — the composition is identical on every screen. */
      .lp-outro-bg {
        position: absolute;
        left: 50%;
        top: 50%;
        transform: translate(-50%, -50%);
        width: auto;
        height: 115%;
      }
      /* Radial vignette: dims the middle a touch for text contrast and takes
         every edge fully to the band color, so the contained image's frame
         never shows. */
      .lp-outro-scrim {
        position: absolute;
        inset: 0;
        background: var(--outro-bg);
        opacity: 0.5;
      }
      .lp-outro-content {
        position: relative;
        z-index: 1;
      }
      .lp-outro-h2 {
        font: 700 48px "Arsenal", "Zen Kaku Gothic New", sans-serif;
        color: var(--on-dark);
      }
      .lp-outro-ctas {
        justify-content: center;
        margin-top: 40px;
      }
      /* The shared CTA classes are styled for the light intro glass; on the
         dark closing band they invert back to light-on-dark. */
      .lp .lp-outro-ctas a.lp-btn-primary {
        background: var(--on-dark);
        color: var(--pri-ink);
      }
      .lp .lp-outro-ctas a.lp-btn-primary:hover {
        background: var(--acc);
        color: var(--on-acc);
      }
      .lp .lp-outro-ctas a.lp-btn-outline {
        border-color: color-mix(in srgb, #fff 45%, transparent);
        color: var(--on-dark);
      }
      .lp .lp-outro-ctas a.lp-btn-outline:hover {
        border-color: var(--acc);
        color: var(--acc);
      }

      .lp-footer {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        z-index: 1;
        padding: 56px 48px calc(48px + var(--lp-safe-b));
        color: var(--on-dark);
        text-align: center;
      }
      .lp-footer-links {
        display: flex;
        justify-content: center;
        gap: 26px;
        font-size: 14px;
        font-weight: 500;
      }
      .lp .lp-footer-links a {
        color: var(--on-dark);
      }
      .lp .lp-footer-links a:hover {
        color: var(--acc);
      }
      .lp-footer-credit {
        margin-top: 28px;
        font-size: 12px;
        color: var(--on-dark-soft);
      }

      /* Responsive — the desktop composition is the reference; tablets tighten
         spacing and stack the widest grids, phones stack everything and turn
         the gallery into a horizontal scroller that preserves the desktop
         layout at a fixed 900px composition width. */
      @media (max-width: 960px) {
        .lp-intro {
          padding: 72px 32px calc(60px + var(--lp-safe-b));
        }
        .lp-intro-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .lp-intro-right {
          padding-top: 0;
        }
        .lp-why {
          padding: 96px 32px 0;
        }
        .lp-values {
          grid-template-columns: 1fr 1fr;
          column-gap: 48px;
          row-gap: 40px;
        }
        /* image showcase (641–960): a taller frame, a narrower caption and a
           smaller ring so the bottom-left caption and bottom-right ring stop
           colliding as the width shrinks (the ≤640 block takes over below) */
        .lp-api-media {
          aspect-ratio: 3 / 2;
        }
        .lp-api-caps {
          max-width: 62%;
        }
        .lp-api-cap-scene {
          display: block;
          margin-left: 0;
          margin-top: 4px;
        }
        .lp-api-ring {
          transform: scale(0.94);
        }
        .lp-hello {
          padding: 88px 32px;
        }
        /* Single column: the result first, code under it. minmax(0, …) lets
           the long code lines scroll inside the card instead of widening it
           past the viewport. Stacked, nothing drives the stretched image
           height, so pin the visual to the source ratio. */
        .lp-hello-grid {
          grid-template-columns: minmax(0, 1fr);
          gap: 36px;
        }
        .lp-hello-side {
          order: -1;
        }
        .lp-hello-visual {
          flex: none;
          aspect-ratio: 16 / 9;
        }
        .lp-arch {
          padding: 88px 32px;
        }
        .lp-gallery-head {
          padding: 36px 32px 80px;
        }
        .lp-maplibre {
          padding: 88px 32px;
        }
        .lp-maplibre-grid {
          grid-template-columns: 1fr;
          gap: 36px;
        }
        .lp-outro {
          padding: 130px 32px;
        }
        /* On a narrow portrait viewport, fill the band instead (the sides
           crop). */
        .lp-outro-bg {
          left: 0;
          top: 0;
          transform: none;
          width: 100%;
          height: 100%;
          object-fit: cover;
        }
        /* Sized so the title holds one line on a 390px viewport. */
        .lp-outro-h2 {
          font-size: 24px;
        }
        .lp-footer {
          padding: 44px 32px calc(40px + var(--lp-safe-b));
        }
      }

      @media (max-width: 640px) {
        .lp-intro {
          padding: 52px 20px calc(44px + var(--lp-safe-b));
        }
        .lp-h1 {
          font-size: 38px;
        }
        .lp-h1-sub {
          margin-top: 14px;
          font-size: 14px;
        }

        .lp-why {
          padding: 72px 20px 0;
        }
        .lp-why-h2 {
          margin-top: 12px;
          font-size: 32px;
          line-height: 1.45;
        }
        .lp-values {
          grid-template-columns: 1fr;
          gap: 28px;
          margin-top: 48px;
        }
        .lp-api-tiers {
          margin-top: 56px;
        }
        /* cap the height so wider phones don't stretch the still so tall that
           the ring and the bottom caption drift far apart */
        .lp-api-media {
          aspect-ratio: 4 / 5;
          max-height: 640px;
        }
        .lp-api-lede {
          max-width: 60%;
          padding: 18px 18px 0;
        }
        /* compact caption near the bottom edge on phones */
        .lp-api-caps {
          max-width: 100%;
          padding: 0 18px 18px;
        }
        .lp-api-cap-title {
          font-size: 16px;
        }
        .lp-api-cap-scene {
          font-size: 12px;
          margin-top: 3px;
        }
        .lp-api-cap-desc {
          margin-top: 8px;
          font-size: 12.5px;
          line-height: 1.5;
        }
        /* on phones the top-left lede and bottom-left caption own the two
           corners, so pin the ring to the right edge just above the caption,
           so it stays close to the text at any phone height */
        .lp-api-ring {
          right: 4px;
          top: auto;
          bottom: 100px;
          transform: scale(0.76);
          transform-origin: bottom right;
        }

        .lp-hello {
          padding: 72px 20px;
        }
        .lp-hello-code pre {
          padding: 20px 22px;
          font-size: 11.5px;
        }
        .lp-hello-cta {
          left: 16px;
          bottom: 12px;
        }
        .lp-arch {
          padding: 72px 20px;
        }
        .lp-h2 {
          font-size: 30px;
        }
        /* Vertical flow on phones, mirroring the original SP diagram: source
           pieces in a row, converging arrows pointing down, then the globe.
           Drop the desktop two-row grid so the cells auto-place down a single
           column in DOM order (head → pieces → arrows → head → globe). */
        .lp-arch-flow {
          /* The wider terrain sits on the left, so the pieces group reads as
             left-leaning even with the marker centred. Nudge the group AND the
             arrow right by the same amount so they stay mutually aligned while
             the group looks centred (the globe stays column-centred). */
          --arch-shift: clamp(0px, 2vw, 15px);
          grid-template-columns: 1fr;
          grid-template-rows: none;
          grid-template-areas: none;
          row-gap: clamp(20px, 6vw, 36px);
          /* The heading keeps the section's shared 20px gutter; only the
             diagram breaks out of it, so the pieces keep the wider canvas
             they are tuned for without misaligning the titles. */
          width: min(480px, calc(100% + 28px));
          margin: 24px -14px 0;
        }
        /* Shift the group right via inside padding (not a transform on the
           full-width box) so it never bleeds past the viewport. padding-left of
           2×shift moves the centred marker right by exactly one shift. */
        .lp-arch-body.is-source {
          padding-left: calc(2 * var(--arch-shift));
        }
        /* Drop the desktop grid-area placement so the cells auto-stack down the
           single column in DOM order (matching-specificity reset). */
        .lp-arch-flow .lp-arch-head,
        .lp-arch-flow .lp-arch-body {
          grid-area: auto;
        }
        .lp-arch-head {
          align-self: auto;
        }
        /* Grid with equal, freely-shrinking side tracks (minmax(0,1fr)) and an
           auto centre track keeps the middle piece (marker) exactly on the
           column's centre line — so it aligns with the arrow's centre —
           regardless of the terrain/buildings widths. */
        .lp-arch-stack {
          display: grid;
          grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr);
          align-items: end;
          column-gap: clamp(20px, 6vw, 40px);
          height: auto;
        }
        .lp-arch-slot:nth-child(1) {
          justify-content: flex-end;
        }
        .lp-arch-slot:nth-child(3) {
          justify-content: flex-start;
        }
        /* Terrain / buildings hug the marker and never exceed their track. */
        .lp-arch-piece {
          max-width: 100%;
        }
        /* Larger source pieces so the group carries similar visual weight to
           the globe. */
        .lp-arch-p-terrain {
          width: clamp(150px, 40vw, 200px);
        }
        .lp-arch-p-marker {
          width: clamp(34px, 9vw, 48px);
        }
        .lp-arch-p-buildings {
          width: clamp(120px, 32vw, 158px);
        }
        .lp-arch-body.is-render {
          justify-content: center;
        }
        /* Globe a touch smaller than full width, balanced against the pieces. */
        .lp-arch-globe {
          width: min(84%, 350px);
        }
        /* Rotate the same arrow asset 90° so it points down. Fixed-height,
           absolutely-centered cell so the rotated box doesn't distort layout. */
        .lp-arch-body.is-arrows {
          position: relative;
          height: clamp(140px, 38vw, 190px);
        }
        .lp-arch-arrow-img {
          position: absolute;
          top: 50%;
          left: 50%;
          height: auto;
          width: clamp(140px, 38vw, 190px);
          max-width: none;
          transform: translate(calc(-50% + var(--arch-shift)), -50%) rotate(90deg);
        }

        .lp-gallery-head {
          padding: 24px 20px 56px;
        }
        /* The grids keep their desktop composition at 900px and the overflow
           scrolls sideways; the label overlay lives outside the scroller, so
           it stays pinned to the viewport edge while images pass under it. */
        .lp-gallery-scroll {
          overflow-x: auto;
          scrollbar-width: none;
        }
        .lp-gallery-scroll::-webkit-scrollbar {
          display: none;
        }
        .lp-tutorial-grid,
        .lp-example-grid,
        .lp-showcase-grid {
          width: 900px;
        }
        .lp-tile-wide {
          height: 440px;
        }
        .lp-tile-half {
          height: 300px;
        }
        .lp-example-grid {
          grid-auto-rows: 320px;
        }
        .lp-gallery-side {
          top: calc(440px - var(--side-h, 220px) - 32px);
        }
        .lp-gallery-side-inner {
          margin: 0 0 32px 20px;
          bottom: 32px;
        }
        .lp-gallery-label {
          letter-spacing: 0.3em;
        }

        .lp-maplibre {
          padding: 72px 20px;
        }
        .lp-maplibre-h2 {
          font-size: 30px;
        }
        .lp-maplibre-visual {
          min-height: 300px;
        }

        .lp-footer {
          padding: 48px 20px calc(40px + var(--lp-safe-b));
        }
        .lp-footer-links {
          flex-wrap: wrap;
          gap: 18px 22px;
        }
      }
    </style>
  </body>
</html>
