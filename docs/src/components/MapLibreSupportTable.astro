---
import supportedStyles from "../content/docs/maplibre_style/supported.json";

interface Props {
  category: "layer" | "source" | "expression" | "root";
  showLegend?: boolean;
}

const { category, showLegend = false } = Astro.props;

const MAPLIBRE_SPEC_BASE = "https://maplibre.org/maplibre-style-spec";

// Category-specific URL paths
const categoryPaths: Record<string, string> = {
  layer: "layers",
  source: "sources",
  expression: "expressions",
  root: "root",
};

// Fetch MapLibre Style Spec reference
const response = await fetch(
  "https://raw.githubusercontent.com/maplibre/maplibre-style-spec/refs/heads/main/src/reference/v8.json"
);
const maplibreReference = await response.json();

// Decode HTML entities
function decodeHtmlEntities(text: string): string {
  const entities: Record<string, string> = {
    '&lt;': '<',
    '&gt;': '>',
    '&le;': '≤',
    '&ge;': '≥',
    '&amp;': '&',
    '&quot;': '"',
    '&apos;': "'",
    '&nbsp;': ' ',
  };

  return text.replace(/&[a-z]+;/gi, (match) => entities[match.toLowerCase()] || '');
}

// Fetch and parse real anchors from MapLibre documentation
async function fetchRealAnchors(category: string): Promise<Map<string, string>> {
  const anchorMap = new Map<string, string>();

  try {
    const categoryUrls: Record<string, string> = {
      layer: "https://maplibre.org/maplibre-style-spec/layers/",
      source: "https://maplibre.org/maplibre-style-spec/sources/",
      expression: "https://maplibre.org/maplibre-style-spec/expressions/",
      root: "https://maplibre.org/maplibre-style-spec/root/",
    };

    const url = categoryUrls[category];
    if (!url) return anchorMap;

    const htmlResponse = await fetch(url);
    const html = await htmlResponse.text();

    if (category === "layer") {
      // For layers, we need to track which layer type each property belongs to
      // Parse the HTML structure to find headings and their anchors
      const headingRegex = /<h([23])[^>]*id=["']([^"']+)["'][^>]*>(.*?)<\/h\1>/gs;
      let match;
      let currentLayerType: string | null = null;

      while ((match = headingRegex.exec(html)) !== null) {
        const level = match[1]; // "2" or "3"
        const anchorId = match[2];
        // Clean heading text: remove HTML tags, decode entities, remove special chars
        const headingText = match[3]
          .replace(/<[^>]+>/g, '') // Remove HTML tags
          .replace(/&para;/gi, '') // Remove paragraph symbol
          .trim();
        const decodedText = decodeHtmlEntities(headingText);

        if (level === "2") {
          // h2 is a layer type
          currentLayerType = anchorId;
          anchorMap.set(anchorId, anchorId);
        } else if (level === "3" && currentLayerType) {
          // h3 is a property under the current layer type
          const propertyName = decodedText;

          // Store mapping: anchorId -> anchorId for direct lookup
          anchorMap.set(anchorId, anchorId);

          // Store mapping: propertyName -> anchorId (for properties like circle-radius)
          anchorMap.set(propertyName, anchorId);

          // Store mapping: layer-property -> anchorId (for properties like visibility)
          const compositeKey = `${currentLayerType}-${propertyName}`;
          anchorMap.set(compositeKey, anchorId);
        }
      }
    } else if (category === "expression" || category === "source" || category === "root") {
      // For expressions, sources, and root: parse headings to map names to anchor IDs
      const headingRegex = /<h[23][^>]*id=["']([^"']+)["'][^>]*>(.*?)<\/h[23]>/gs;
      let match;

      while ((match = headingRegex.exec(html)) !== null) {
        const anchorId = match[1];
        // Clean heading text: remove HTML tags and paragraph symbol
        const headingText = match[2]
          .replace(/<[^>]+>/g, '') // Remove HTML tags
          .replace(/&para;/gi, '') // Remove paragraph symbol
          .trim();
        // Decode HTML entities like &lt; &gt; &le;
        const decodedText = decodeHtmlEntities(headingText);

        // Store both the anchor ID and the heading text mapping
        anchorMap.set(anchorId, anchorId);
        anchorMap.set(decodedText, anchorId);
      }
    } else {
      // Fallback: simple anchor mapping
      const anchorRegex = /id=["']([^"']+)["']/g;
      let match;

      while ((match = anchorRegex.exec(html)) !== null) {
        const anchorId = match[1];
        anchorMap.set(anchorId, anchorId);
      }
    }
  } catch (error) {
    console.warn(`Failed to fetch anchors for ${category}:`, error);
  }

  return anchorMap;
}

const realAnchors = await fetchRealAnchors(category);

// Build rows based on category
type Row = {
  name: string;
  url: string;
  status: string;
  isHeader?: boolean;
};

const categoryPath = categoryPaths[category];
const supportedItems = supportedStyles[category] || {};
let rows: Row[] = [];

switch (category) {
  case "layer": {
    // For layers, show layer types and their paint/layout properties
    const layerTypes = Object.keys(maplibreReference.layer.type.values);

    for (const layerType of layerTypes.sort()) {
      // Add layer type as header
      const layerSupported = supportedItems[layerType];
      const layerStatus = layerSupported
        ? typeof layerSupported === "string"
          ? layerSupported
          : (layerSupported as any).status
        : "❌";

      rows.push({
        name: layerType,
        url: `${MAPLIBRE_SPEC_BASE}/${categoryPath}/#${realAnchors.get(layerType) || layerType}`,
        status: layerStatus,
        isHeader: true,
      });

      // Add paint properties
      const paintKey = `paint_${layerType}`;
      if (maplibreReference[paintKey]) {
        const paintProps = Object.keys(maplibreReference[paintKey]).filter(
          key => !key.startsWith('*')
        );
        for (const propName of paintProps.sort()) {
          const propSupported = layerSupported?.paint?.[propName];
          const propStatus = propSupported
            ? typeof propSupported === "string"
              ? propSupported
              : propSupported.status
            : "❌";

          // Try to find the real anchor using multiple strategies:
          // 1. Try layer-property composite key (for shared properties like visibility)
          // 2. Try property name directly (for properties like circle-radius)
          // 3. Fall back to property name
          const anchor =
            realAnchors.get(`${layerType}-${propName}`) ||
            realAnchors.get(propName) ||
            propName;

          rows.push({
            name: `  ${propName}`,
            url: `${MAPLIBRE_SPEC_BASE}/${categoryPath}/#${anchor}`,
            status: propStatus,
          });
        }
      }

      // Add layout properties
      const layoutKey = `layout_${layerType}`;
      if (maplibreReference[layoutKey]) {
        const layoutProps = Object.keys(maplibreReference[layoutKey]).filter(
          key => !key.startsWith('*')
        );
        for (const propName of layoutProps.sort()) {
          const propSupported = layerSupported?.layout?.[propName];
          const propStatus = propSupported
            ? typeof propSupported === "string"
              ? propSupported
              : propSupported.status
            : "❌";

          // Try to find the real anchor using multiple strategies:
          // 1. Try layer-property composite key (for shared properties like visibility)
          // 2. Try property name directly (for properties like circle-radius)
          // 3. Fall back to property name
          const anchor =
            realAnchors.get(`${layerType}-${propName}`) ||
            realAnchors.get(propName) ||
            propName;

          rows.push({
            name: `  ${propName}`,
            url: `${MAPLIBRE_SPEC_BASE}/${categoryPath}/#${anchor}`,
            status: propStatus,
          });
        }
      }
    }
    break;
  }
  case "source": {
    // Source types
    const sourceTypes = maplibreReference.source.flatMap((sourceKey: string) =>
      Object.keys(maplibreReference[sourceKey]?.type?.values || {})
    );
    rows = sourceTypes.sort().map((name: string) => {
      const supported = supportedItems[name];
      const status = supported
        ? typeof supported === "string"
          ? supported
          : (supported as any).status
        : "❌";
      return {
        name,
        url: `${MAPLIBRE_SPEC_BASE}/${categoryPath}/#${realAnchors.get(name) || name}`,
        status,
      };
    });
    break;
  }
  case "expression": {
    // Expression operators
    const operators = Object.keys(maplibreReference.expression_name.values);
    rows = operators.sort().map((name) => {
      const supported = supportedItems[name];
      const status = supported
        ? typeof supported === "string"
          ? supported
          : (supported as any).status
        : "❌";
      return {
        name,
        url: `${MAPLIBRE_SPEC_BASE}/${categoryPath}/#${realAnchors.get(name) || name}`,
        status,
      };
    });
    break;
  }
  case "root": {
    // Root features - extract from $root in the spec
    const rootProps = Object.keys(maplibreReference.$root).filter(
      key => !key.startsWith('*') && key !== 'required'
    );
    rows = rootProps.sort().map((name) => {
      const supported = supportedItems[name];
      const status = supported
        ? typeof supported === "string"
          ? supported
          : (supported as any).status
        : "❌";
      return {
        name,
        url: `${MAPLIBRE_SPEC_BASE}/root/#${realAnchors.get(name) || name}`,
        status,
      };
    });
    break;
  }
}
---

{showLegend && (
  <p><strong>Legend:</strong></p>
  <ul>
    <li>✅ Supported</li>
    <li>⚠️ Partial support</li>
    <li>❌ Not supported</li>
  </ul>
)}

<table>
  <thead>
    <tr>
      <th>Name</th>
      <th>Status</th>
    </tr>
  </thead>
  <tbody>
    {rows.map((row) => (
      <tr class={row.isHeader ? "header-row" : ""}>
        <td>
          <a href={row.url} target="_blank" rel="noopener noreferrer">
            {row.name}
          </a>
        </td>
        <td>{row.status}</td>
      </tr>
    ))}
  </tbody>
</table>

<style>
  .header-row {
    font-weight: bold;
    background-color: var(--sl-color-gray-6);
  }
</style>
