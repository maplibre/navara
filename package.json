{
  "name": "navara",
  "version": "0.0.0",
  "private": true,
  "description": "",
  "engines": {
    "node": ">=24",
    "pnpm": "11.28.6"
  },
  "packageManager": "pnpm@11.28.6",
  "scripts": {
    "navara_three": "pnpm -C web/navara_three",
    "integration-tests": "pnpm -filter './web/integration-tests/**'",
    "star": "pnpm navara_three start",
    "dev": "pnpm navara_three dev",
    "dev:integration": "pnpm integration-tests -r run dev",
    "preview": "pnpm navara_three preview",
    "build": "pnpm --filter-prod './web/**' --filter-prod '!./web/integration-tests/**' run build",
    "build:common:dev": "NODE_ENV=development pnpm -r --parallel run build:dev:watch",
    "build:iife": "pnpm -C web/navara_three run build:iife",
    "build:example": "pnpm build && pnpm -r run build:example",
    "build:integration": "pnpm integration-tests -r run build",
    "test": "pnpm --filter './web/**' -r run test",
    "test:maplibre": "pnpm -C web/navara_maplibre_style/integration-test test:maplibre",
    "format": "pnpm --filter './web/**' -r run format",
    "format:check": "pnpm --filter './web/**' -r run format:check",
    "lint": "pnpm --filter './web/**' -r run lint",
    "lint:check": "pnpm --filter './web/**' -r run lint:check",
    "dev:docs": "pnpm -C docs dev",
    "build:docs": "pnpm -C docs build",
    "preview:docs": "pnpm -C docs preview",
    "assemble:site": "node scripts/assemble-site.mjs",
    "build:site": "pnpm build:example && pnpm build:docs && pnpm assemble:site",
    "preview:site": "wrangler dev",
    "deploy:site": "pnpm assemble:site && wrangler deploy",
    "deploy:redirects": "wrangler deploy -c workers/redirects/navara-preview/wrangler.jsonc",
    "pack:externals": "pnpm pack -r --pack-destination externals --filter './web/**' --filter '!./web/integration-tests/**' --filter '!./web/navara_maplibre_style/integration-test'"
  },
  "license": "MIT OR Apache-2.0",
  "dependencies": {
    "lodash-es": "4.18.1",
    "tiny-invariant": "1.3.3"
  },
  "devDependencies": {
    "@microsoft/api-extractor": "7.58.11",
    "@navaramap/engine": "workspace:*",
    "@navaramap/engine-api": "workspace:*",
    "@navaramap/engine-font-worker": "workspace:*",
    "@navaramap/engine-worker": "workspace:*",
    "@types/geojson": "7946.0.16",
    "@types/lodash-es": "4.17.12",
    "@types/node": "26.2.0",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.5",
    "@typescript-eslint/utils": "8.67.0",
    "@vitejs/plugin-react": "6.0.3",
    "eslint": "10.8.1",
    "eslint-config-reearth": "0.4.0",
    "jsdom": "30.0.1",
    "prettier": "3.9.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "shadcn": "4.22.1",
    "typescript": "7.0.2",
    "unplugin-dts": "1.0.3",
    "vite": "8.2.4",
    "vite-plugin-top-level-await": "1.6.0",
    "vite-plugin-wasm": "3.6.0",
    "vite-tsconfig-paths": "6.1.1",
    "vitest": "5.0.5",
    "wrangler": "^4.127.0"
  }
}