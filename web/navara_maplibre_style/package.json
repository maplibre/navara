{
  "name": "@navaramap/maplibre-style",
  "type": "module",
  "version": "0.0.0",
  "main": "dist/index.umd.cjs",
  "module": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "src",
    "dist"
  ],
  "scripts": {
    "type-check": "tsc -p tsconfig.build.json && tsc -p tsconfig.node.json",
    "build": "pnpm type-check && vite build --watch=false",
    "build:dev": "vite build --mode development",
    "build:dev:watch": "pnpm build:dev --watch",
    "test": "vitest --passWithNoTests --watch=false",
    "lint": "eslint . --fix",
    "lint:check": "eslint .",
    "format": "prettier --write --ignore-path ../../.gitignore .",
    "format:check": "prettier --check --ignore-path ../../.gitignore ."
  },
  "license": "MIT OR Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/maplibre/navara.git",
    "directory": "web/navara_maplibre_style"
  },
  "publishConfig": {
    "access": "public"
  },
  "peerDependencies": {
    "@navaramap/three": "workspace:*"
  },
  "dependencies": {
    "@maplibre/maplibre-gl-style-spec": "26.2.1",
    "@navaramap/core": "workspace:*",
    "@navaramap/engine": "workspace:*",
    "@navaramap/three-plugins": "workspace:*",
    "@types/geojson": "7946.0.16"
  },
  "devDependencies": {
    "@navaramap/three": "workspace:*"
  }
}
