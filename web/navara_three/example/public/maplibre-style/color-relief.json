{
    "version": 8,
    "name": "Color Relief Test",
    "projection": {
        "type": "globe"
      },
    "center": [138.73, 35.27],
    "zoom": 9,
    "pitch": 60,
    "sources": {
        "osm": {
            "type": "raster",
            "tiles": ["https://tile.openstreetmap.org/{z}/{x}/{y}.png"],
            "tileSize": 256,
            "maxzoom": 19
        },
        "terrain-1": {
            "type": "raster-dem",
            "tiles": [
                "https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"
            ],
            "tileSize": 512,
            "encoding": "terrarium",
            "maxzoom": 10
        },
        "terrain-2": {
            "type": "raster-dem",
            "tiles": [
                "https://tiles.mapterhorn.com/{z}/{x}/{y}.webp"
            ],
            "tileSize": 512,
            "encoding": "terrarium",
            "maxzoom": 10
        }
    },
    "layers": [
        {
            "id": "osm-basemap",
            "type": "raster",
            "source": "osm",
            "paint": {
                "raster-opacity": 1.0
            }
        },
        {
            "id": "color-relief1",
            "type": "color-relief",
            "source": "terrain-1",
            "metadata": {
                "test": [
                    "interpolate-hcl with exponential interpolation (rendered linearly between stops, as in MapLibre)",
                    "unevenly spaced stops: transparent sea, sharp coastline at 0-1 m, Mt. Fuji summit at 3776 m",
                    "stop colors as hex with alpha, rgb()/hsl() strings, a color name, and rgb/rgba/to-color expressions",
                    "color-relief-opacity zoom expression: 0.9 at z8 fading to 0.4 at z12",
                    "resampling zoom step: linear below z12, nearest from z12"
                ]
            },
            "paint": {
                "color-relief-opacity": [
                    "interpolate",
                    ["linear"],
                    ["zoom"],
                    8, 0.9,
                    12, 0.4
                ],
                "color-relief-color": [
                    "interpolate-hcl",
                    ["exponential", 1.5],
                    ["elevation"],
                    0, "#0000ff00",
                    1, "rgb(0, 128, 64)",
                    100, ["rgb", 120, 200, 80],
                    500, "hsl(60, 80%, 55%)",
                    1500, ["to-color", "#f9781e"],
                    2500, ["rgba", 142, 10, 1, 0.9],
                    3776, "white"
                ],
                "resampling": ["step", ["zoom"], "linear", 12, "nearest"]
            },
            "layout": {
                "visibility": "visible"
            }
        },
        {
            "id": "color-relief2",
            "type": "color-relief",
            "source": "terrain-2",
            "metadata": {
                "test": [
                    "a second color-relief layer stacked on the first, with its own stops and range",
                    "interpolate-lab with cubic-bezier interpolation",
                    "contrasting colors so the overlay is easy to spot: transparent below 1000 m, translucent purple at 2000 m, opaque cyan from 3000 m",
                    "input as an expression of elevation: [\"max\", [\"elevation\"], 0] (stop values are still meters)",
                    "a stop color that reads the elevation: alpha = elevation / 3333.33, i.e. 0.6 at the 2000 m stop",
                    "constant color-relief-opacity",
                    "resampling as a legacy zoom function (converted by migrate)"
                ]
            },
            "paint": {
                "color-relief-opacity": 0.8,
                "color-relief-color": [
                    "interpolate-lab",
                    ["cubic-bezier", 0.4, 0, 0.6, 1],
                    ["max", ["elevation"], 0],
                    1000, "rgba(128, 0, 255, 0)",
                    2000, ["rgba", 128, 0, 255, ["/", ["elevation"], 3333.33]],
                    3000, "#00ffff"
                ],
                "resampling": {
                    "stops": [
                        [10, "linear"],
                        [13, "nearest"]
                    ]
                }
            },
            "layout": {
                "visibility": "visible"
            }
        },
        {
            "id": "hillshade",
            "type": "hillshade",
            "source": "terrain-1"
        }
    ],
    "terrain": {
        "source": "terrain-1",
        "exaggeration": 1.5
    }
}
