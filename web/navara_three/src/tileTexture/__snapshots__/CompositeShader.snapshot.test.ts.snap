// Vitest Snapshot v1, https://vitest.dev/guide/snapshot.html

exports[`generateCompositeFragmentShader snapshots > all features on, mixed raster+vector 1`] = `
"
precision highp float;
precision highp int;

#include <common>

varying vec2 vUv;



uniform int uShows[4];
uniform vec3 uColors[4];
uniform float uOpacities[4];
uniform sampler2D uTextures[4];
uniform vec2 uLayerUvOffset[4];
uniform vec2 uLayerUvScale[4];
uniform int uReproject[4];
uniform vec2 uReprojectTerrainLat[4];
// CPU-precomputed per-slot reprojection constants (see mutates.ts):
//   .xy = (mRs, mDen) — source tile's Mercator band start + span,
//   .z  = clamp-to-top-edge flag, .w = clamp-to-bottom-edge flag (polar cap).
uniform vec4 uReprojectMerc[4];
uniform bool uIsHillshades[4];
uniform float uHillshadeExaggeration;
// Packed elevation heatmap params: (isElevationHeatmap, usesBilinear, colorMapRow, logBoundary)
uniform vec4 uElevationHeatmapParams[4];
// Per-layer (minHeight, maxHeight, stopCount, hasColorStops): the normalization range and the color ramp shape
uniform vec4 uElevationRangeAndRamp[4];
uniform vec4 uElevationRGBScalersAndBoundaries[4];  // (r, g, b, boundary)
uniform vec4 uElevationDecoderOffsets[4];  // (minOffset, maxOffset, epsilon, offset)
uniform bool uWaters[4];

uniform sampler2D uWatermask;


#if USE_ELEVATION_HEATMAP
  float nvr_branchFreeTernary(bool comparison, float a, float b) {
    float useA = float(comparison);
    return a * useA + b * (1.0 - useA);
}

vec2 nvr_branchFreeTernary(bool comparison, vec2 a, vec2 b) {
    float useA = float(comparison);
    return a * useA + b * (1.0 - useA);
}

vec3 nvr_branchFreeTernary(bool comparison, vec3 a, vec3 b) {
    float useA = float(comparison);
    return a * useA + b * (1.0 - useA);
}

vec4 nvr_branchFreeTernary(bool comparison, vec4 a, vec4 b) {
    float useA = float(comparison);
    return a * useA + b * (1.0 - useA);
}
  #ifndef DEM_UTIL_GLSL
#define DEM_UTIL_GLSL

bool isPowerOfTwo(int n) {
  return n > 0 && ((n & (n - 1)) == 0);
}

const float invalidHeight = -999999.0; 
bool isValidHeight(float h) {
  return h > -999998.0; 
}

struct DEMBilinearData {
  ivec2 p00, p10, p01, p11;  
  vec2 frac;                  
};

DEMBilinearData prepareDEMBilinear(ivec2 actualTexSize, vec2 uv) {
  vec2 paddedTexSize = vec2(actualTexSize);

  
  
  
  bool hasPadding = !isPowerOfTwo(actualTexSize.x);

  vec2 contentSize = hasPadding ? paddedTexSize - vec2(2.0) : paddedTexSize;

  
  
  
  
  
  
  
  
  vec2 pixelCoord = hasPadding
    ? uv * (contentSize - vec2(1.0)) + vec2(1.0)  
    : uv * (contentSize - vec2(1.0));              

  vec2 pixelFloor = floor(pixelCoord);
  vec2 pixelFrac = fract(pixelCoord);

  
  
  ivec2 maxCoord = ivec2(paddedTexSize) - ivec2(1);

  DEMBilinearData data;
  data.p00 = clamp(ivec2(pixelFloor), ivec2(0), maxCoord);
  data.p10 = clamp(ivec2(pixelFloor + vec2(1.0, 0.0)), ivec2(0), maxCoord);
  data.p01 = clamp(ivec2(pixelFloor + vec2(0.0, 1.0)), ivec2(0), maxCoord);
  data.p11 = clamp(ivec2(pixelFloor + vec2(1.0, 1.0)), ivec2(0), maxCoord);
  data.frac = pixelFrac;

  return data;
}

float decodeDEMHeight(vec4 color, vec3 rgbScaler, float boundary, float minOffset, float maxOffset, float epsilon, float offset) {
  vec3 rgb = color.rgb * 255.0;
  float x = dot(rgb, rgbScaler);

  float h;
  float epsilon_cmp = 1.0; 
  if (abs(x - boundary) > epsilon_cmp) {
    if (x > boundary) {
      h = x + maxOffset;  
    } else {
      h = x + minOffset;  
    }
    
    h = h * epsilon + offset;
  } else {
    h = invalidHeight;  
  }

  return h;
}

float interpolateDEMHeights(float h00, float h10, float h01, float h11, vec2 frac) {
  
  if (!isValidHeight(h00)) return invalidHeight;

  
  
  float maxReasonableDiff = 1000.0;
  
  
  if (isValidHeight(h10) && abs(h10 - h00) > maxReasonableDiff) h10 = h00;
  if (isValidHeight(h01) && abs(h01 - h00) > maxReasonableDiff) h01 = h00;
  if (isValidHeight(h11) && abs(h11 - h00) > maxReasonableDiff) h11 = h00;

  
  if (!isValidHeight(h10)) h10 = h00;
  if (!isValidHeight(h01)) h01 = h00;
  if (!isValidHeight(h11)) h11 = h00;

  
  float h0 = mix(h00, h10, frac.x);
  float h1 = mix(h01, h11, frac.x);
  return mix(h0, h1, frac.y);
}

#endif

  uniform sampler2D uColorMapTexture;

  
  
  float pseudoLog(float value, float logBase, float logBoundary) {
    return value > logBoundary ? log(value) / logBase : value < -logBoundary ? -log(-value) / logBase : value / logBoundary;
  }

  
  
  float decodeRawHeightForElevation(vec4 color, int slot) {
    return decodeDEMHeight(
      color,
      uElevationRGBScalersAndBoundaries[slot].xyz,  
      uElevationRGBScalersAndBoundaries[slot].w,    
      uElevationDecoderOffsets[slot].x,             
      uElevationDecoderOffsets[slot].y,             
      uElevationDecoderOffsets[slot].z,             
      uElevationDecoderOffsets[slot].w              
    );
  }

  
  
  float normalizeElevationHeight(float h, float minHeight, float maxHeight, bool logarithmic, float logBase, float logBoundary) {
    float normalizedMinHeight = minHeight;
    float normalizedMaxHeight = maxHeight;
    float value = h;
    
    
    
    if (logarithmic) {
      normalizedMinHeight = pseudoLog(minHeight, logBase, logBoundary);
      normalizedMaxHeight = pseudoLog(maxHeight, logBase, logBoundary);
      value = pseudoLog(h, logBase, logBoundary);
    }

    
    float range = max(normalizedMaxHeight - normalizedMinHeight, 1e-6);
    return clamp((value - normalizedMinHeight) / range, 0.0, 1.0);
  }

  
  
  
  
  float sampleElevationBilinear(sampler2D demTexture, vec2 uv, ivec2 texSize, int slot, out bool valid) {
    
    DEMBilinearData data = prepareDEMBilinear(texSize, uv);

    float h = invalidHeight; 

    
    float h00 = decodeRawHeightForElevation(texelFetch(demTexture, data.p00, 0), slot);
    if(isValidHeight(h00)) {
      float h10 = decodeRawHeightForElevation(texelFetch(demTexture, data.p10, 0), slot);
      float h01 = decodeRawHeightForElevation(texelFetch(demTexture, data.p01, 0), slot);
      float h11 = decodeRawHeightForElevation(texelFetch(demTexture, data.p11, 0), slot);

      
      h = interpolateDEMHeights(h00, h10, h01, h11, data.frac);
    }

    valid = isValidHeight(h);
    return valid ? h : 0.0;
  }

  
  
  
  
  float sampleElevationNearest(sampler2D demTexture, vec2 uv, ivec2 texSize, int slot, out bool valid) {
    
    vec2 pixelCoord = uv * vec2(texSize);
    ivec2 nearestPixel = ivec2(floor(pixelCoord + 0.5));

    
    nearestPixel = clamp(nearestPixel, ivec2(0), texSize - 1);

    
    float h = decodeRawHeightForElevation(texelFetch(demTexture, nearestPixel, 0), slot);

    valid = isValidHeight(h);
    return valid ? h : 0.0;
  }

  
  
  
  
  
  vec4 sampleColorRamp(int row, int stopCount, float key) {
    int l = 0;
    int r = stopCount - 1;
    float pl = texelFetch(uColorMapTexture, ivec2(1, row), 0).r;
    float pr = texelFetch(uColorMapTexture, ivec2(r * 2 + 1, row), 0).r;
    while (r - l > 1) {
      int m = (l + r) / 2;
      float pm = texelFetch(uColorMapTexture, ivec2(m * 2 + 1, row), 0).r;
      if (key < pm) {
        r = m;
        pr = pm;
      } else {
        l = m;
        pl = pm;
      }
    }
    float t = pr > pl ? clamp((key - pl) / (pr - pl), 0.0, 1.0) : step(pr, key);
    vec4 c = mix(
      texelFetch(uColorMapTexture, ivec2(l * 2, row), 0),
      texelFetch(uColorMapTexture, ivec2(r * 2, row), 0),
      t
    );
    return c.a > 0.0 ? vec4(c.rgb / c.a, c.a) : vec4(0.0);
  }
#endif

layout(location = 0) out vec4 colorBuffer;
layout(location = 1) out vec4 attrBuffer;
layout(location = 2) out vec4 normalBuffer;

void main() {
  vec4 compositedColor = vec4(0.0);
  int winningSlot = -1;
  float isWater = 0.0;
  float isTexturized = 0.0;

  vec3 hillshadeNormal = vec3(0.5, 0.5, 1.0); // neutral upward
  bool hasHillshadeNormal = false;

  // Shared WebMercator reprojection latitude for this fragment. The terrain lat
  // range is tile-wide, so mLat is identical across every reprojecting slot —
  // computed lazily on first use and reused by the rest (see reproject block).
  float gReprojMLat = 0.0;
  bool gReprojMLatReady = false;


  // ---- compact slot 0 (absolute slot 0, raster) ----
  if (uShows[0] == 1) {
    vec2 texUv0 = vUv * uLayerUvScale[0] + uLayerUvOffset[0];
    // 1.0 unless the reproject branch below confines this slot to a sub-rect.
    float inBounds0 = 1.0;

    if (uReproject[0] == 1) {
      // Affine UV is correct in longitude but stretches latitude. Remap this
      // fragment's latitude through Mercator so it samples the source correctly.
      //
      // The only per-fragment transcendental left is mLat: it depends solely on
      // vUv.y and the (tile-wide, slot-invariant) terrain lat range, so it is
      // identical for every reprojecting slot — computed once and reused. The
      // per-slot source band (mRs, mDen) and polar-cap flags are constant per slot
      // and precomputed on the CPU (see mutates.ts), so no log/tan runs per slot.
      if (!gReprojMLatReady) {
        float lat = uReprojectTerrainLat[0].x
          + vUv.y * (uReprojectTerrainLat[0].y - uReprojectTerrainLat[0].x);
        gReprojMLat = log(tan(PI * 0.25 + lat * 0.5));
        gReprojMLatReady = true;
      }
      float mRs = uReprojectMerc[0].x;
      float mDen = uReprojectMerc[0].y;
      // Only reproject when the source's Mercator span is wide enough to be
      // numerically safe. For deep/upsampled tiles the span shrinks to ~1e-6 while
      // mLat/mRs are ~O(1), so (mLat-mRs)/(mRn-mRs) catastrophically cancels in
      // float32 and produces vertical-stretch noise. There the Mercator correction
      // is sub-pixel anyway, so the affine texUv.y is both correct and stable.
      if (abs(mDen) > 1e-3) {
        texUv0.y = (gReprojMLat - mRs) / mDen;
      }
      // Polar cap fill: WebMercator content stops at ±~85.05° but Geographic
      // terrain reaches ±90°. When this slot is the band-edge source (its
      // north/south edge sits on the WM limit), clamp the polar overshoot onto
      // that edge texel so the last available source row stretches across the cap
      // instead of being dropped by the in-bounds test below. Non-edge tiles keep
      // the normal drop.
      if (uReprojectMerc[0].z > 0.5) texUv0.y = min(texUv0.y, 1.0);
      if (uReprojectMerc[0].w > 0.5) texUv0.y = max(texUv0.y, 0.0);
      // Confine the slot to the sub-rect it actually covers. With N:M draping each
      // source tile covers only part of the terrain tile; outside its [0,1] range
      // the sampler would smear the edge texel across the rest, so drop it there.
      inBounds0 = step(0.0, texUv0.x) * step(texUv0.x, 1.0)
                   * step(0.0, texUv0.y) * step(texUv0.y, 1.0);
    }

    vec4 texColor0;
    // Extract packed params: (isElevationHeatmap, usesBilinear, colorMapRow, logBoundary)
    vec4 params0 = uElevationHeatmapParams[0];
    bool isElevationHeatmap0 = params0.x > 0.5;

    if (isElevationHeatmap0) {
      bool usesBilinear0 = params0.y > 0.5;
      float logBoundary = params0.w;

      ivec2 demTexSize = textureSize(uTextures[0], 0);
      bool demValid0;
      float h0 = usesBilinear0
        ? sampleElevationBilinear(uTextures[0], texUv0, demTexSize, 0, demValid0)
        : sampleElevationNearest(uTextures[0], texUv0, demTexSize, 0, demValid0);

      // Ramp key: the height itself for colorStops (meters), otherwise the
      // height normalized with the layer's own minHeight/maxHeight and
      // logarithmic scaling (0 = off, >0 = on with boundary value).
      vec4 rangeAndRamp0 = uElevationRangeAndRamp[0];
      float key0 = h0;
      if (rangeAndRamp0.w < 0.5) {
        bool logarithmic = logBoundary > 0.0;
        float logBase = logarithmic ? log(logBoundary) : 1.0;  // ln(boundary)
        key0 = normalizeElevationHeight(h0, rangeAndRamp0.x, rangeAndRamp0.y, logarithmic, logBase, logBoundary);
      }

      // The ramp's (straight) alpha is kept; no-data texels stay transparent.
      vec4 mapped0 = sampleColorRamp(int(params0.z), int(rangeAndRamp0.z), key0);
      texColor0 = vec4(mapped0.rgb, demValid0 ? mapped0.a : 0.0);
    } else {
      texColor0 = texture2D(uTextures[0], texUv0) * vec4(uColors[0], 1.0);
    }

    if (uIsHillshades[0]) {
      texColor0 = vec4(0.0);
    }
    float alpha0 = texColor0.a * uOpacities[0] * inBounds0;
    if (alpha0 > 0.01) {
      compositedColor = mix(compositedColor, vec4(texColor0.rgb, 1.0), alpha0);
      winningSlot = 0;
      isTexturized = 0.0;

      isWater = uWaters[0] ? 1.0 : 0.0;
    }
  }

  // ---- compact slot 1 (absolute slot 1, raster) ----
  if (uShows[1] == 1) {
    vec2 texUv1 = vUv * uLayerUvScale[1] + uLayerUvOffset[1];
    // 1.0 unless the reproject branch below confines this slot to a sub-rect.
    float inBounds1 = 1.0;

    if (uReproject[1] == 1) {
      // Affine UV is correct in longitude but stretches latitude. Remap this
      // fragment's latitude through Mercator so it samples the source correctly.
      //
      // The only per-fragment transcendental left is mLat: it depends solely on
      // vUv.y and the (tile-wide, slot-invariant) terrain lat range, so it is
      // identical for every reprojecting slot — computed once and reused. The
      // per-slot source band (mRs, mDen) and polar-cap flags are constant per slot
      // and precomputed on the CPU (see mutates.ts), so no log/tan runs per slot.
      if (!gReprojMLatReady) {
        float lat = uReprojectTerrainLat[1].x
          + vUv.y * (uReprojectTerrainLat[1].y - uReprojectTerrainLat[1].x);
        gReprojMLat = log(tan(PI * 0.25 + lat * 0.5));
        gReprojMLatReady = true;
      }
      float mRs = uReprojectMerc[1].x;
      float mDen = uReprojectMerc[1].y;
      // Only reproject when the source's Mercator span is wide enough to be
      // numerically safe. For deep/upsampled tiles the span shrinks to ~1e-6 while
      // mLat/mRs are ~O(1), so (mLat-mRs)/(mRn-mRs) catastrophically cancels in
      // float32 and produces vertical-stretch noise. There the Mercator correction
      // is sub-pixel anyway, so the affine texUv.y is both correct and stable.
      if (abs(mDen) > 1e-3) {
        texUv1.y = (gReprojMLat - mRs) / mDen;
      }
      // Polar cap fill: WebMercator content stops at ±~85.05° but Geographic
      // terrain reaches ±90°. When this slot is the band-edge source (its
      // north/south edge sits on the WM limit), clamp the polar overshoot onto
      // that edge texel so the last available source row stretches across the cap
      // instead of being dropped by the in-bounds test below. Non-edge tiles keep
      // the normal drop.
      if (uReprojectMerc[1].z > 0.5) texUv1.y = min(texUv1.y, 1.0);
      if (uReprojectMerc[1].w > 0.5) texUv1.y = max(texUv1.y, 0.0);
      // Confine the slot to the sub-rect it actually covers. With N:M draping each
      // source tile covers only part of the terrain tile; outside its [0,1] range
      // the sampler would smear the edge texel across the rest, so drop it there.
      inBounds1 = step(0.0, texUv1.x) * step(texUv1.x, 1.0)
                   * step(0.0, texUv1.y) * step(texUv1.y, 1.0);
    }

    vec4 texColor1;
    // Extract packed params: (isElevationHeatmap, usesBilinear, colorMapRow, logBoundary)
    vec4 params1 = uElevationHeatmapParams[1];
    bool isElevationHeatmap1 = params1.x > 0.5;

    if (isElevationHeatmap1) {
      bool usesBilinear1 = params1.y > 0.5;
      float logBoundary = params1.w;

      ivec2 demTexSize = textureSize(uTextures[1], 0);
      bool demValid1;
      float h1 = usesBilinear1
        ? sampleElevationBilinear(uTextures[1], texUv1, demTexSize, 1, demValid1)
        : sampleElevationNearest(uTextures[1], texUv1, demTexSize, 1, demValid1);

      // Ramp key: the height itself for colorStops (meters), otherwise the
      // height normalized with the layer's own minHeight/maxHeight and
      // logarithmic scaling (0 = off, >0 = on with boundary value).
      vec4 rangeAndRamp1 = uElevationRangeAndRamp[1];
      float key1 = h1;
      if (rangeAndRamp1.w < 0.5) {
        bool logarithmic = logBoundary > 0.0;
        float logBase = logarithmic ? log(logBoundary) : 1.0;  // ln(boundary)
        key1 = normalizeElevationHeight(h1, rangeAndRamp1.x, rangeAndRamp1.y, logarithmic, logBase, logBoundary);
      }

      // The ramp's (straight) alpha is kept; no-data texels stay transparent.
      vec4 mapped1 = sampleColorRamp(int(params1.z), int(rangeAndRamp1.z), key1);
      texColor1 = vec4(mapped1.rgb, demValid1 ? mapped1.a : 0.0);
    } else {
      texColor1 = texture2D(uTextures[1], texUv1) * vec4(uColors[1], 1.0);
    }

    if (uIsHillshades[1]) {
      texColor1 = vec4(0.0);
    }
    float alpha1 = texColor1.a * uOpacities[1] * inBounds1;
    if (alpha1 > 0.01) {
      compositedColor = mix(compositedColor, vec4(texColor1.rgb, 1.0), alpha1);
      winningSlot = 1;
      isTexturized = 0.0;

      isWater = uWaters[1] ? 1.0 : 0.0;
    }
  }

  // ---- compact slot 2 (absolute slot 2, vector) ----
  if (uShows[2] == 1) {
    vec2 texUv2 = vUv * uLayerUvScale[2] + uLayerUvOffset[2];
    // 1.0 unless the reproject branch below confines this slot to a sub-rect.
    float inBounds2 = 1.0;

    if (uReproject[2] == 1) {
      // Affine UV is correct in longitude but stretches latitude. Remap this
      // fragment's latitude through Mercator so it samples the source correctly.
      //
      // The only per-fragment transcendental left is mLat: it depends solely on
      // vUv.y and the (tile-wide, slot-invariant) terrain lat range, so it is
      // identical for every reprojecting slot — computed once and reused. The
      // per-slot source band (mRs, mDen) and polar-cap flags are constant per slot
      // and precomputed on the CPU (see mutates.ts), so no log/tan runs per slot.
      if (!gReprojMLatReady) {
        float lat = uReprojectTerrainLat[2].x
          + vUv.y * (uReprojectTerrainLat[2].y - uReprojectTerrainLat[2].x);
        gReprojMLat = log(tan(PI * 0.25 + lat * 0.5));
        gReprojMLatReady = true;
      }
      float mRs = uReprojectMerc[2].x;
      float mDen = uReprojectMerc[2].y;
      // Only reproject when the source's Mercator span is wide enough to be
      // numerically safe. For deep/upsampled tiles the span shrinks to ~1e-6 while
      // mLat/mRs are ~O(1), so (mLat-mRs)/(mRn-mRs) catastrophically cancels in
      // float32 and produces vertical-stretch noise. There the Mercator correction
      // is sub-pixel anyway, so the affine texUv.y is both correct and stable.
      if (abs(mDen) > 1e-3) {
        texUv2.y = (gReprojMLat - mRs) / mDen;
      }
      // Polar cap fill: WebMercator content stops at ±~85.05° but Geographic
      // terrain reaches ±90°. When this slot is the band-edge source (its
      // north/south edge sits on the WM limit), clamp the polar overshoot onto
      // that edge texel so the last available source row stretches across the cap
      // instead of being dropped by the in-bounds test below. Non-edge tiles keep
      // the normal drop.
      if (uReprojectMerc[2].z > 0.5) texUv2.y = min(texUv2.y, 1.0);
      if (uReprojectMerc[2].w > 0.5) texUv2.y = max(texUv2.y, 0.0);
      // Confine the slot to the sub-rect it actually covers. With N:M draping each
      // source tile covers only part of the terrain tile; outside its [0,1] range
      // the sampler would smear the edge texel across the rest, so drop it there.
      inBounds2 = step(0.0, texUv2.x) * step(texUv2.x, 1.0)
                   * step(0.0, texUv2.y) * step(texUv2.y, 1.0);
    }

    vec4 texColor2;
    // Extract packed params: (isElevationHeatmap, usesBilinear, colorMapRow, logBoundary)
    vec4 params2 = uElevationHeatmapParams[2];
    bool isElevationHeatmap2 = params2.x > 0.5;

    if (isElevationHeatmap2) {
      bool usesBilinear2 = params2.y > 0.5;
      float logBoundary = params2.w;

      ivec2 demTexSize = textureSize(uTextures[2], 0);
      bool demValid2;
      float h2 = usesBilinear2
        ? sampleElevationBilinear(uTextures[2], texUv2, demTexSize, 2, demValid2)
        : sampleElevationNearest(uTextures[2], texUv2, demTexSize, 2, demValid2);

      // Ramp key: the height itself for colorStops (meters), otherwise the
      // height normalized with the layer's own minHeight/maxHeight and
      // logarithmic scaling (0 = off, >0 = on with boundary value).
      vec4 rangeAndRamp2 = uElevationRangeAndRamp[2];
      float key2 = h2;
      if (rangeAndRamp2.w < 0.5) {
        bool logarithmic = logBoundary > 0.0;
        float logBase = logarithmic ? log(logBoundary) : 1.0;  // ln(boundary)
        key2 = normalizeElevationHeight(h2, rangeAndRamp2.x, rangeAndRamp2.y, logarithmic, logBase, logBoundary);
      }

      // The ramp's (straight) alpha is kept; no-data texels stay transparent.
      vec4 mapped2 = sampleColorRamp(int(params2.z), int(rangeAndRamp2.z), key2);
      texColor2 = vec4(mapped2.rgb, demValid2 ? mapped2.a : 0.0);
    } else {
      texColor2 = texture2D(uTextures[2], texUv2) * vec4(uColors[2], 1.0);
    }

    if (uIsHillshades[2]) {
      texColor2 = vec4(0.0);
    }
    float alpha2 = texColor2.a * uOpacities[2] * inBounds2;
    if (alpha2 > 0.01) {
      compositedColor = mix(compositedColor, vec4(texColor2.rgb, 1.0), alpha2);
      winningSlot = 2;
      isTexturized = 1.0;

      isWater = uWaters[2] ? 1.0 : 0.0;
    }
  }

  // ---- compact slot 3 (absolute slot 3, vector) ----
  if (uShows[3] == 1) {
    vec2 texUv3 = vUv * uLayerUvScale[3] + uLayerUvOffset[3];
    // 1.0 unless the reproject branch below confines this slot to a sub-rect.
    float inBounds3 = 1.0;

    if (uReproject[3] == 1) {
      // Affine UV is correct in longitude but stretches latitude. Remap this
      // fragment's latitude through Mercator so it samples the source correctly.
      //
      // The only per-fragment transcendental left is mLat: it depends solely on
      // vUv.y and the (tile-wide, slot-invariant) terrain lat range, so it is
      // identical for every reprojecting slot — computed once and reused. The
      // per-slot source band (mRs, mDen) and polar-cap flags are constant per slot
      // and precomputed on the CPU (see mutates.ts), so no log/tan runs per slot.
      if (!gReprojMLatReady) {
        float lat = uReprojectTerrainLat[3].x
          + vUv.y * (uReprojectTerrainLat[3].y - uReprojectTerrainLat[3].x);
        gReprojMLat = log(tan(PI * 0.25 + lat * 0.5));
        gReprojMLatReady = true;
      }
      float mRs = uReprojectMerc[3].x;
      float mDen = uReprojectMerc[3].y;
      // Only reproject when the source's Mercator span is wide enough to be
      // numerically safe. For deep/upsampled tiles the span shrinks to ~1e-6 while
      // mLat/mRs are ~O(1), so (mLat-mRs)/(mRn-mRs) catastrophically cancels in
      // float32 and produces vertical-stretch noise. There the Mercator correction
      // is sub-pixel anyway, so the affine texUv.y is both correct and stable.
      if (abs(mDen) > 1e-3) {
        texUv3.y = (gReprojMLat - mRs) / mDen;
      }
      // Polar cap fill: WebMercator content stops at ±~85.05° but Geographic
      // terrain reaches ±90°. When this slot is the band-edge source (its
      // north/south edge sits on the WM limit), clamp the polar overshoot onto
      // that edge texel so the last available source row stretches across the cap
      // instead of being dropped by the in-bounds test below. Non-edge tiles keep
      // the normal drop.
      if (uReprojectMerc[3].z > 0.5) texUv3.y = min(texUv3.y, 1.0);
      if (uReprojectMerc[3].w > 0.5) texUv3.y = max(texUv3.y, 0.0);
      // Confine the slot to the sub-rect it actually covers. With N:M draping each
      // source tile covers only part of the terrain tile; outside its [0,1] range
      // the sampler would smear the edge texel across the rest, so drop it there.
      inBounds3 = step(0.0, texUv3.x) * step(texUv3.x, 1.0)
                   * step(0.0, texUv3.y) * step(texUv3.y, 1.0);
    }

    vec4 texColor3;
    // Extract packed params: (isElevationHeatmap, usesBilinear, colorMapRow, logBoundary)
    vec4 params3 = uElevationHeatmapParams[3];
    bool isElevationHeatmap3 = params3.x > 0.5;

    if (isElevationHeatmap3) {
      bool usesBilinear3 = params3.y > 0.5;
      float logBoundary = params3.w;

      ivec2 demTexSize = textureSize(uTextures[3], 0);
      bool demValid3;
      float h3 = usesBilinear3
        ? sampleElevationBilinear(uTextures[3], texUv3, demTexSize, 3, demValid3)
        : sampleElevationNearest(uTextures[3], texUv3, demTexSize, 3, demValid3);

      // Ramp key: the height itself for colorStops (meters), otherwise the
      // height normalized with the layer's own minHeight/maxHeight and
      // logarithmic scaling (0 = off, >0 = on with boundary value).
      vec4 rangeAndRamp3 = uElevationRangeAndRamp[3];
      float key3 = h3;
      if (rangeAndRamp3.w < 0.5) {
        bool logarithmic = logBoundary > 0.0;
        float logBase = logarithmic ? log(logBoundary) : 1.0;  // ln(boundary)
        key3 = normalizeElevationHeight(h3, rangeAndRamp3.x, rangeAndRamp3.y, logarithmic, logBase, logBoundary);
      }

      // The ramp's (straight) alpha is kept; no-data texels stay transparent.
      vec4 mapped3 = sampleColorRamp(int(params3.z), int(rangeAndRamp3.z), key3);
      texColor3 = vec4(mapped3.rgb, demValid3 ? mapped3.a : 0.0);
    } else {
      texColor3 = texture2D(uTextures[3], texUv3) * vec4(uColors[3], 1.0);
    }

    if (uIsHillshades[3]) {
      texColor3 = vec4(0.0);
    }
    float alpha3 = texColor3.a * uOpacities[3] * inBounds3;
    if (alpha3 > 0.01) {
      compositedColor = mix(compositedColor, vec4(texColor3.rgb, 1.0), alpha3);
      winningSlot = 3;
      isTexturized = 1.0;

      isWater = uWaters[3] ? 1.0 : 0.0;
    }
  }


  if (uIsHillshades[0]) {
    ivec2 normalMapSize0 = textureSize(uTextures[0], 0);
    if (normalMapSize0.x > 1 && normalMapSize0.y > 1) {
      vec2 hillshadeUv0 = clamp(vUv * uLayerUvScale[0] + uLayerUvOffset[0], vec2(0.0), vec2(1.0));
      vec3 n0 = texture2D(uTextures[0], hillshadeUv0).rgb * 2.0 - 1.0;
      n0 = normalize(n0);
      n0.xy *= uHillshadeExaggeration;
      n0 = normalize(n0);
      hillshadeNormal = n0 * 0.5 + 0.5; // store in [0,1]
      hasHillshadeNormal = true;
    }
  }

  if (uIsHillshades[1]) {
    ivec2 normalMapSize1 = textureSize(uTextures[1], 0);
    if (normalMapSize1.x > 1 && normalMapSize1.y > 1) {
      vec2 hillshadeUv1 = clamp(vUv * uLayerUvScale[1] + uLayerUvOffset[1], vec2(0.0), vec2(1.0));
      vec3 n1 = texture2D(uTextures[1], hillshadeUv1).rgb * 2.0 - 1.0;
      n1 = normalize(n1);
      n1.xy *= uHillshadeExaggeration;
      n1 = normalize(n1);
      hillshadeNormal = n1 * 0.5 + 0.5; // store in [0,1]
      hasHillshadeNormal = true;
    }
  }

  if (uIsHillshades[2]) {
    ivec2 normalMapSize2 = textureSize(uTextures[2], 0);
    if (normalMapSize2.x > 1 && normalMapSize2.y > 1) {
      vec2 hillshadeUv2 = clamp(vUv * uLayerUvScale[2] + uLayerUvOffset[2], vec2(0.0), vec2(1.0));
      vec3 n2 = texture2D(uTextures[2], hillshadeUv2).rgb * 2.0 - 1.0;
      n2 = normalize(n2);
      n2.xy *= uHillshadeExaggeration;
      n2 = normalize(n2);
      hillshadeNormal = n2 * 0.5 + 0.5; // store in [0,1]
      hasHillshadeNormal = true;
    }
  }

  if (uIsHillshades[3]) {
    ivec2 normalMapSize3 = textureSize(uTextures[3], 0);
    if (normalMapSize3.x > 1 && normalMapSize3.y > 1) {
      vec2 hillshadeUv3 = clamp(vUv * uLayerUvScale[3] + uLayerUvOffset[3], vec2(0.0), vec2(1.0));
      vec3 n3 = texture2D(uTextures[3], hillshadeUv3).rgb * 2.0 - 1.0;
      n3 = normalize(n3);
      n3.xy *= uHillshadeExaggeration;
      n3 = normalize(n3);
      hillshadeNormal = n3 * 0.5 + 0.5; // store in [0,1]
      hasHillshadeNormal = true;
    }
  }

  // Quantized-mesh watermask: 0 = land, 255 = water (per spec). Takes priority
  // over per-slot uWaters — even if no winning slot flagged water, watermask
  // can still mark this pixel as water. Threshold at 0.5 (byte > 127).
  isWater = max(isWater, step(0.5, texture(uWatermask, vUv).r));

  colorBuffer = compositedColor;

  // Attr.a packs the winning slot index as (idx+1)/255 — 0 means no winner.
  // Main shader: int winIdx = int(round(attr.a * 255.0)) - 1.
  attrBuffer = vec4(
    isWater,
    isTexturized,
    0.0,
    float(winningSlot + 1) / 255.0
  );

  normalBuffer = vec4(hillshadeNormal, hasHillshadeNormal ? 1.0 : 0.0);
}
"
`;

exports[`generateCompositeFragmentShader snapshots > elevation heatmap only 1`] = `
"
precision highp float;
precision highp int;

#include <common>

varying vec2 vUv;



uniform int uShows[2];
uniform vec3 uColors[2];
uniform float uOpacities[2];
uniform sampler2D uTextures[2];
uniform vec2 uLayerUvOffset[2];
uniform vec2 uLayerUvScale[2];
uniform int uReproject[2];
uniform vec2 uReprojectTerrainLat[2];
// CPU-precomputed per-slot reprojection constants (see mutates.ts):
//   .xy = (mRs, mDen) — source tile's Mercator band start + span,
//   .z  = clamp-to-top-edge flag, .w = clamp-to-bottom-edge flag (polar cap).
uniform vec4 uReprojectMerc[2];
// Packed elevation heatmap params: (isElevationHeatmap, usesBilinear, colorMapRow, logBoundary)
uniform vec4 uElevationHeatmapParams[2];
// Per-layer (minHeight, maxHeight, stopCount, hasColorStops): the normalization range and the color ramp shape
uniform vec4 uElevationRangeAndRamp[2];
uniform vec4 uElevationRGBScalersAndBoundaries[2];  // (r, g, b, boundary)
uniform vec4 uElevationDecoderOffsets[2];  // (minOffset, maxOffset, epsilon, offset)




#if USE_ELEVATION_HEATMAP
  float nvr_branchFreeTernary(bool comparison, float a, float b) {
    float useA = float(comparison);
    return a * useA + b * (1.0 - useA);
}

vec2 nvr_branchFreeTernary(bool comparison, vec2 a, vec2 b) {
    float useA = float(comparison);
    return a * useA + b * (1.0 - useA);
}

vec3 nvr_branchFreeTernary(bool comparison, vec3 a, vec3 b) {
    float useA = float(comparison);
    return a * useA + b * (1.0 - useA);
}

vec4 nvr_branchFreeTernary(bool comparison, vec4 a, vec4 b) {
    float useA = float(comparison);
    return a * useA + b * (1.0 - useA);
}
  #ifndef DEM_UTIL_GLSL
#define DEM_UTIL_GLSL

bool isPowerOfTwo(int n) {
  return n > 0 && ((n & (n - 1)) == 0);
}

const float invalidHeight = -999999.0; 
bool isValidHeight(float h) {
  return h > -999998.0; 
}

struct DEMBilinearData {
  ivec2 p00, p10, p01, p11;  
  vec2 frac;                  
};

DEMBilinearData prepareDEMBilinear(ivec2 actualTexSize, vec2 uv) {
  vec2 paddedTexSize = vec2(actualTexSize);

  
  
  
  bool hasPadding = !isPowerOfTwo(actualTexSize.x);

  vec2 contentSize = hasPadding ? paddedTexSize - vec2(2.0) : paddedTexSize;

  
  
  
  
  
  
  
  
  vec2 pixelCoord = hasPadding
    ? uv * (contentSize - vec2(1.0)) + vec2(1.0)  
    : uv * (contentSize - vec2(1.0));              

  vec2 pixelFloor = floor(pixelCoord);
  vec2 pixelFrac = fract(pixelCoord);

  
  
  ivec2 maxCoord = ivec2(paddedTexSize) - ivec2(1);

  DEMBilinearData data;
  data.p00 = clamp(ivec2(pixelFloor), ivec2(0), maxCoord);
  data.p10 = clamp(ivec2(pixelFloor + vec2(1.0, 0.0)), ivec2(0), maxCoord);
  data.p01 = clamp(ivec2(pixelFloor + vec2(0.0, 1.0)), ivec2(0), maxCoord);
  data.p11 = clamp(ivec2(pixelFloor + vec2(1.0, 1.0)), ivec2(0), maxCoord);
  data.frac = pixelFrac;

  return data;
}

float decodeDEMHeight(vec4 color, vec3 rgbScaler, float boundary, float minOffset, float maxOffset, float epsilon, float offset) {
  vec3 rgb = color.rgb * 255.0;
  float x = dot(rgb, rgbScaler);

  float h;
  float epsilon_cmp = 1.0; 
  if (abs(x - boundary) > epsilon_cmp) {
    if (x > boundary) {
      h = x + maxOffset;  
    } else {
      h = x + minOffset;  
    }
    
    h = h * epsilon + offset;
  } else {
    h = invalidHeight;  
  }

  return h;
}

float interpolateDEMHeights(float h00, float h10, float h01, float h11, vec2 frac) {
  
  if (!isValidHeight(h00)) return invalidHeight;

  
  
  float maxReasonableDiff = 1000.0;
  
  
  if (isValidHeight(h10) && abs(h10 - h00) > maxReasonableDiff) h10 = h00;
  if (isValidHeight(h01) && abs(h01 - h00) > maxReasonableDiff) h01 = h00;
  if (isValidHeight(h11) && abs(h11 - h00) > maxReasonableDiff) h11 = h00;

  
  if (!isValidHeight(h10)) h10 = h00;
  if (!isValidHeight(h01)) h01 = h00;
  if (!isValidHeight(h11)) h11 = h00;

  
  float h0 = mix(h00, h10, frac.x);
  float h1 = mix(h01, h11, frac.x);
  return mix(h0, h1, frac.y);
}

#endif

  uniform sampler2D uColorMapTexture;

  
  
  float pseudoLog(float value, float logBase, float logBoundary) {
    return value > logBoundary ? log(value) / logBase : value < -logBoundary ? -log(-value) / logBase : value / logBoundary;
  }

  
  
  float decodeRawHeightForElevation(vec4 color, int slot) {
    return decodeDEMHeight(
      color,
      uElevationRGBScalersAndBoundaries[slot].xyz,  
      uElevationRGBScalersAndBoundaries[slot].w,    
      uElevationDecoderOffsets[slot].x,             
      uElevationDecoderOffsets[slot].y,             
      uElevationDecoderOffsets[slot].z,             
      uElevationDecoderOffsets[slot].w              
    );
  }

  
  
  float normalizeElevationHeight(float h, float minHeight, float maxHeight, bool logarithmic, float logBase, float logBoundary) {
    float normalizedMinHeight = minHeight;
    float normalizedMaxHeight = maxHeight;
    float value = h;
    
    
    
    if (logarithmic) {
      normalizedMinHeight = pseudoLog(minHeight, logBase, logBoundary);
      normalizedMaxHeight = pseudoLog(maxHeight, logBase, logBoundary);
      value = pseudoLog(h, logBase, logBoundary);
    }

    
    float range = max(normalizedMaxHeight - normalizedMinHeight, 1e-6);
    return clamp((value - normalizedMinHeight) / range, 0.0, 1.0);
  }

  
  
  
  
  float sampleElevationBilinear(sampler2D demTexture, vec2 uv, ivec2 texSize, int slot, out bool valid) {
    
    DEMBilinearData data = prepareDEMBilinear(texSize, uv);

    float h = invalidHeight; 

    
    float h00 = decodeRawHeightForElevation(texelFetch(demTexture, data.p00, 0), slot);
    if(isValidHeight(h00)) {
      float h10 = decodeRawHeightForElevation(texelFetch(demTexture, data.p10, 0), slot);
      float h01 = decodeRawHeightForElevation(texelFetch(demTexture, data.p01, 0), slot);
      float h11 = decodeRawHeightForElevation(texelFetch(demTexture, data.p11, 0), slot);

      
      h = interpolateDEMHeights(h00, h10, h01, h11, data.frac);
    }

    valid = isValidHeight(h);
    return valid ? h : 0.0;
  }

  
  
  
  
  float sampleElevationNearest(sampler2D demTexture, vec2 uv, ivec2 texSize, int slot, out bool valid) {
    
    vec2 pixelCoord = uv * vec2(texSize);
    ivec2 nearestPixel = ivec2(floor(pixelCoord + 0.5));

    
    nearestPixel = clamp(nearestPixel, ivec2(0), texSize - 1);

    
    float h = decodeRawHeightForElevation(texelFetch(demTexture, nearestPixel, 0), slot);

    valid = isValidHeight(h);
    return valid ? h : 0.0;
  }

  
  
  
  
  
  vec4 sampleColorRamp(int row, int stopCount, float key) {
    int l = 0;
    int r = stopCount - 1;
    float pl = texelFetch(uColorMapTexture, ivec2(1, row), 0).r;
    float pr = texelFetch(uColorMapTexture, ivec2(r * 2 + 1, row), 0).r;
    while (r - l > 1) {
      int m = (l + r) / 2;
      float pm = texelFetch(uColorMapTexture, ivec2(m * 2 + 1, row), 0).r;
      if (key < pm) {
        r = m;
        pr = pm;
      } else {
        l = m;
        pl = pm;
      }
    }
    float t = pr > pl ? clamp((key - pl) / (pr - pl), 0.0, 1.0) : step(pr, key);
    vec4 c = mix(
      texelFetch(uColorMapTexture, ivec2(l * 2, row), 0),
      texelFetch(uColorMapTexture, ivec2(r * 2, row), 0),
      t
    );
    return c.a > 0.0 ? vec4(c.rgb / c.a, c.a) : vec4(0.0);
  }
#endif

layout(location = 0) out vec4 colorBuffer;
layout(location = 1) out vec4 attrBuffer;
layout(location = 2) out vec4 normalBuffer;

void main() {
  vec4 compositedColor = vec4(0.0);
  int winningSlot = -1;
  float isWater = 0.0;
  float isTexturized = 0.0;

  vec3 hillshadeNormal = vec3(0.5, 0.5, 1.0); // neutral upward
  bool hasHillshadeNormal = false;

  // Shared WebMercator reprojection latitude for this fragment. The terrain lat
  // range is tile-wide, so mLat is identical across every reprojecting slot —
  // computed lazily on first use and reused by the rest (see reproject block).
  float gReprojMLat = 0.0;
  bool gReprojMLatReady = false;


  // ---- compact slot 0 (absolute slot 0, raster) ----
  if (uShows[0] == 1) {
    vec2 texUv0 = vUv * uLayerUvScale[0] + uLayerUvOffset[0];
    // 1.0 unless the reproject branch below confines this slot to a sub-rect.
    float inBounds0 = 1.0;

    if (uReproject[0] == 1) {
      // Affine UV is correct in longitude but stretches latitude. Remap this
      // fragment's latitude through Mercator so it samples the source correctly.
      //
      // The only per-fragment transcendental left is mLat: it depends solely on
      // vUv.y and the (tile-wide, slot-invariant) terrain lat range, so it is
      // identical for every reprojecting slot — computed once and reused. The
      // per-slot source band (mRs, mDen) and polar-cap flags are constant per slot
      // and precomputed on the CPU (see mutates.ts), so no log/tan runs per slot.
      if (!gReprojMLatReady) {
        float lat = uReprojectTerrainLat[0].x
          + vUv.y * (uReprojectTerrainLat[0].y - uReprojectTerrainLat[0].x);
        gReprojMLat = log(tan(PI * 0.25 + lat * 0.5));
        gReprojMLatReady = true;
      }
      float mRs = uReprojectMerc[0].x;
      float mDen = uReprojectMerc[0].y;
      // Only reproject when the source's Mercator span is wide enough to be
      // numerically safe. For deep/upsampled tiles the span shrinks to ~1e-6 while
      // mLat/mRs are ~O(1), so (mLat-mRs)/(mRn-mRs) catastrophically cancels in
      // float32 and produces vertical-stretch noise. There the Mercator correction
      // is sub-pixel anyway, so the affine texUv.y is both correct and stable.
      if (abs(mDen) > 1e-3) {
        texUv0.y = (gReprojMLat - mRs) / mDen;
      }
      // Polar cap fill: WebMercator content stops at ±~85.05° but Geographic
      // terrain reaches ±90°. When this slot is the band-edge source (its
      // north/south edge sits on the WM limit), clamp the polar overshoot onto
      // that edge texel so the last available source row stretches across the cap
      // instead of being dropped by the in-bounds test below. Non-edge tiles keep
      // the normal drop.
      if (uReprojectMerc[0].z > 0.5) texUv0.y = min(texUv0.y, 1.0);
      if (uReprojectMerc[0].w > 0.5) texUv0.y = max(texUv0.y, 0.0);
      // Confine the slot to the sub-rect it actually covers. With N:M draping each
      // source tile covers only part of the terrain tile; outside its [0,1] range
      // the sampler would smear the edge texel across the rest, so drop it there.
      inBounds0 = step(0.0, texUv0.x) * step(texUv0.x, 1.0)
                   * step(0.0, texUv0.y) * step(texUv0.y, 1.0);
    }

    vec4 texColor0;
    // Extract packed params: (isElevationHeatmap, usesBilinear, colorMapRow, logBoundary)
    vec4 params0 = uElevationHeatmapParams[0];
    bool isElevationHeatmap0 = params0.x > 0.5;

    if (isElevationHeatmap0) {
      bool usesBilinear0 = params0.y > 0.5;
      float logBoundary = params0.w;

      ivec2 demTexSize = textureSize(uTextures[0], 0);
      bool demValid0;
      float h0 = usesBilinear0
        ? sampleElevationBilinear(uTextures[0], texUv0, demTexSize, 0, demValid0)
        : sampleElevationNearest(uTextures[0], texUv0, demTexSize, 0, demValid0);

      // Ramp key: the height itself for colorStops (meters), otherwise the
      // height normalized with the layer's own minHeight/maxHeight and
      // logarithmic scaling (0 = off, >0 = on with boundary value).
      vec4 rangeAndRamp0 = uElevationRangeAndRamp[0];
      float key0 = h0;
      if (rangeAndRamp0.w < 0.5) {
        bool logarithmic = logBoundary > 0.0;
        float logBase = logarithmic ? log(logBoundary) : 1.0;  // ln(boundary)
        key0 = normalizeElevationHeight(h0, rangeAndRamp0.x, rangeAndRamp0.y, logarithmic, logBase, logBoundary);
      }

      // The ramp's (straight) alpha is kept; no-data texels stay transparent.
      vec4 mapped0 = sampleColorRamp(int(params0.z), int(rangeAndRamp0.z), key0);
      texColor0 = vec4(mapped0.rgb, demValid0 ? mapped0.a : 0.0);
    } else {
      texColor0 = texture2D(uTextures[0], texUv0) * vec4(uColors[0], 1.0);
    }

    float alpha0 = texColor0.a * uOpacities[0] * inBounds0;
    if (alpha0 > 0.01) {
      compositedColor = mix(compositedColor, vec4(texColor0.rgb, 1.0), alpha0);
      winningSlot = 0;
      isTexturized = 0.0;

    }
  }

  // ---- compact slot 1 (absolute slot 1, raster) ----
  if (uShows[1] == 1) {
    vec2 texUv1 = vUv * uLayerUvScale[1] + uLayerUvOffset[1];
    // 1.0 unless the reproject branch below confines this slot to a sub-rect.
    float inBounds1 = 1.0;

    if (uReproject[1] == 1) {
      // Affine UV is correct in longitude but stretches latitude. Remap this
      // fragment's latitude through Mercator so it samples the source correctly.
      //
      // The only per-fragment transcendental left is mLat: it depends solely on
      // vUv.y and the (tile-wide, slot-invariant) terrain lat range, so it is
      // identical for every reprojecting slot — computed once and reused. The
      // per-slot source band (mRs, mDen) and polar-cap flags are constant per slot
      // and precomputed on the CPU (see mutates.ts), so no log/tan runs per slot.
      if (!gReprojMLatReady) {
        float lat = uReprojectTerrainLat[1].x
          + vUv.y * (uReprojectTerrainLat[1].y - uReprojectTerrainLat[1].x);
        gReprojMLat = log(tan(PI * 0.25 + lat * 0.5));
        gReprojMLatReady = true;
      }
      float mRs = uReprojectMerc[1].x;
      float mDen = uReprojectMerc[1].y;
      // Only reproject when the source's Mercator span is wide enough to be
      // numerically safe. For deep/upsampled tiles the span shrinks to ~1e-6 while
      // mLat/mRs are ~O(1), so (mLat-mRs)/(mRn-mRs) catastrophically cancels in
      // float32 and produces vertical-stretch noise. There the Mercator correction
      // is sub-pixel anyway, so the affine texUv.y is both correct and stable.
      if (abs(mDen) > 1e-3) {
        texUv1.y = (gReprojMLat - mRs) / mDen;
      }
      // Polar cap fill: WebMercator content stops at ±~85.05° but Geographic
      // terrain reaches ±90°. When this slot is the band-edge source (its
      // north/south edge sits on the WM limit), clamp the polar overshoot onto
      // that edge texel so the last available source row stretches across the cap
      // instead of being dropped by the in-bounds test below. Non-edge tiles keep
      // the normal drop.
      if (uReprojectMerc[1].z > 0.5) texUv1.y = min(texUv1.y, 1.0);
      if (uReprojectMerc[1].w > 0.5) texUv1.y = max(texUv1.y, 0.0);
      // Confine the slot to the sub-rect it actually covers. With N:M draping each
      // source tile covers only part of the terrain tile; outside its [0,1] range
      // the sampler would smear the edge texel across the rest, so drop it there.
      inBounds1 = step(0.0, texUv1.x) * step(texUv1.x, 1.0)
                   * step(0.0, texUv1.y) * step(texUv1.y, 1.0);
    }

    vec4 texColor1;
    // Extract packed params: (isElevationHeatmap, usesBilinear, colorMapRow, logBoundary)
    vec4 params1 = uElevationHeatmapParams[1];
    bool isElevationHeatmap1 = params1.x > 0.5;

    if (isElevationHeatmap1) {
      bool usesBilinear1 = params1.y > 0.5;
      float logBoundary = params1.w;

      ivec2 demTexSize = textureSize(uTextures[1], 0);
      bool demValid1;
      float h1 = usesBilinear1
        ? sampleElevationBilinear(uTextures[1], texUv1, demTexSize, 1, demValid1)
        : sampleElevationNearest(uTextures[1], texUv1, demTexSize, 1, demValid1);

      // Ramp key: the height itself for colorStops (meters), otherwise the
      // height normalized with the layer's own minHeight/maxHeight and
      // logarithmic scaling (0 = off, >0 = on with boundary value).
      vec4 rangeAndRamp1 = uElevationRangeAndRamp[1];
      float key1 = h1;
      if (rangeAndRamp1.w < 0.5) {
        bool logarithmic = logBoundary > 0.0;
        float logBase = logarithmic ? log(logBoundary) : 1.0;  // ln(boundary)
        key1 = normalizeElevationHeight(h1, rangeAndRamp1.x, rangeAndRamp1.y, logarithmic, logBase, logBoundary);
      }

      // The ramp's (straight) alpha is kept; no-data texels stay transparent.
      vec4 mapped1 = sampleColorRamp(int(params1.z), int(rangeAndRamp1.z), key1);
      texColor1 = vec4(mapped1.rgb, demValid1 ? mapped1.a : 0.0);
    } else {
      texColor1 = texture2D(uTextures[1], texUv1) * vec4(uColors[1], 1.0);
    }

    float alpha1 = texColor1.a * uOpacities[1] * inBounds1;
    if (alpha1 > 0.01) {
      compositedColor = mix(compositedColor, vec4(texColor1.rgb, 1.0), alpha1);
      winningSlot = 1;
      isTexturized = 0.0;

    }
  }



  colorBuffer = compositedColor;

  // Attr.a packs the winning slot index as (idx+1)/255 — 0 means no winner.
  // Main shader: int winIdx = int(round(attr.a * 255.0)) - 1.
  attrBuffer = vec4(
    isWater,
    isTexturized,
    0.0,
    float(winningSlot + 1) / 255.0
  );

  normalBuffer = vec4(hillshadeNormal, hasHillshadeNormal ? 1.0 : 0.0);
}
"
`;

exports[`generateCompositeFragmentShader snapshots > hillshade only 1`] = `
"
precision highp float;
precision highp int;

#include <common>

varying vec2 vUv;



uniform int uShows[2];
uniform vec3 uColors[2];
uniform float uOpacities[2];
uniform sampler2D uTextures[2];
uniform vec2 uLayerUvOffset[2];
uniform vec2 uLayerUvScale[2];
uniform int uReproject[2];
uniform vec2 uReprojectTerrainLat[2];
// CPU-precomputed per-slot reprojection constants (see mutates.ts):
//   .xy = (mRs, mDen) — source tile's Mercator band start + span,
//   .z  = clamp-to-top-edge flag, .w = clamp-to-bottom-edge flag (polar cap).
uniform vec4 uReprojectMerc[2];
uniform bool uIsHillshades[2];
uniform float uHillshadeExaggeration;






layout(location = 0) out vec4 colorBuffer;
layout(location = 1) out vec4 attrBuffer;
layout(location = 2) out vec4 normalBuffer;

void main() {
  vec4 compositedColor = vec4(0.0);
  int winningSlot = -1;
  float isWater = 0.0;
  float isTexturized = 0.0;

  vec3 hillshadeNormal = vec3(0.5, 0.5, 1.0); // neutral upward
  bool hasHillshadeNormal = false;

  // Shared WebMercator reprojection latitude for this fragment. The terrain lat
  // range is tile-wide, so mLat is identical across every reprojecting slot —
  // computed lazily on first use and reused by the rest (see reproject block).
  float gReprojMLat = 0.0;
  bool gReprojMLatReady = false;


  // ---- compact slot 0 (absolute slot 0, raster) ----
  if (uShows[0] == 1) {
    vec2 texUv0 = vUv * uLayerUvScale[0] + uLayerUvOffset[0];
    // 1.0 unless the reproject branch below confines this slot to a sub-rect.
    float inBounds0 = 1.0;

    if (uReproject[0] == 1) {
      // Affine UV is correct in longitude but stretches latitude. Remap this
      // fragment's latitude through Mercator so it samples the source correctly.
      //
      // The only per-fragment transcendental left is mLat: it depends solely on
      // vUv.y and the (tile-wide, slot-invariant) terrain lat range, so it is
      // identical for every reprojecting slot — computed once and reused. The
      // per-slot source band (mRs, mDen) and polar-cap flags are constant per slot
      // and precomputed on the CPU (see mutates.ts), so no log/tan runs per slot.
      if (!gReprojMLatReady) {
        float lat = uReprojectTerrainLat[0].x
          + vUv.y * (uReprojectTerrainLat[0].y - uReprojectTerrainLat[0].x);
        gReprojMLat = log(tan(PI * 0.25 + lat * 0.5));
        gReprojMLatReady = true;
      }
      float mRs = uReprojectMerc[0].x;
      float mDen = uReprojectMerc[0].y;
      // Only reproject when the source's Mercator span is wide enough to be
      // numerically safe. For deep/upsampled tiles the span shrinks to ~1e-6 while
      // mLat/mRs are ~O(1), so (mLat-mRs)/(mRn-mRs) catastrophically cancels in
      // float32 and produces vertical-stretch noise. There the Mercator correction
      // is sub-pixel anyway, so the affine texUv.y is both correct and stable.
      if (abs(mDen) > 1e-3) {
        texUv0.y = (gReprojMLat - mRs) / mDen;
      }
      // Polar cap fill: WebMercator content stops at ±~85.05° but Geographic
      // terrain reaches ±90°. When this slot is the band-edge source (its
      // north/south edge sits on the WM limit), clamp the polar overshoot onto
      // that edge texel so the last available source row stretches across the cap
      // instead of being dropped by the in-bounds test below. Non-edge tiles keep
      // the normal drop.
      if (uReprojectMerc[0].z > 0.5) texUv0.y = min(texUv0.y, 1.0);
      if (uReprojectMerc[0].w > 0.5) texUv0.y = max(texUv0.y, 0.0);
      // Confine the slot to the sub-rect it actually covers. With N:M draping each
      // source tile covers only part of the terrain tile; outside its [0,1] range
      // the sampler would smear the edge texel across the rest, so drop it there.
      inBounds0 = step(0.0, texUv0.x) * step(texUv0.x, 1.0)
                   * step(0.0, texUv0.y) * step(texUv0.y, 1.0);
    }

    vec4 texColor0 = texture2D(uTextures[0], texUv0) * vec4(uColors[0], 1.0);

    if (uIsHillshades[0]) {
      texColor0 = vec4(0.0);
    }
    float alpha0 = texColor0.a * uOpacities[0] * inBounds0;
    if (alpha0 > 0.01) {
      compositedColor = mix(compositedColor, vec4(texColor0.rgb, 1.0), alpha0);
      winningSlot = 0;
      isTexturized = 0.0;

    }
  }

  // ---- compact slot 1 (absolute slot 1, raster) ----
  if (uShows[1] == 1) {
    vec2 texUv1 = vUv * uLayerUvScale[1] + uLayerUvOffset[1];
    // 1.0 unless the reproject branch below confines this slot to a sub-rect.
    float inBounds1 = 1.0;

    if (uReproject[1] == 1) {
      // Affine UV is correct in longitude but stretches latitude. Remap this
      // fragment's latitude through Mercator so it samples the source correctly.
      //
      // The only per-fragment transcendental left is mLat: it depends solely on
      // vUv.y and the (tile-wide, slot-invariant) terrain lat range, so it is
      // identical for every reprojecting slot — computed once and reused. The
      // per-slot source band (mRs, mDen) and polar-cap flags are constant per slot
      // and precomputed on the CPU (see mutates.ts), so no log/tan runs per slot.
      if (!gReprojMLatReady) {
        float lat = uReprojectTerrainLat[1].x
          + vUv.y * (uReprojectTerrainLat[1].y - uReprojectTerrainLat[1].x);
        gReprojMLat = log(tan(PI * 0.25 + lat * 0.5));
        gReprojMLatReady = true;
      }
      float mRs = uReprojectMerc[1].x;
      float mDen = uReprojectMerc[1].y;
      // Only reproject when the source's Mercator span is wide enough to be
      // numerically safe. For deep/upsampled tiles the span shrinks to ~1e-6 while
      // mLat/mRs are ~O(1), so (mLat-mRs)/(mRn-mRs) catastrophically cancels in
      // float32 and produces vertical-stretch noise. There the Mercator correction
      // is sub-pixel anyway, so the affine texUv.y is both correct and stable.
      if (abs(mDen) > 1e-3) {
        texUv1.y = (gReprojMLat - mRs) / mDen;
      }
      // Polar cap fill: WebMercator content stops at ±~85.05° but Geographic
      // terrain reaches ±90°. When this slot is the band-edge source (its
      // north/south edge sits on the WM limit), clamp the polar overshoot onto
      // that edge texel so the last available source row stretches across the cap
      // instead of being dropped by the in-bounds test below. Non-edge tiles keep
      // the normal drop.
      if (uReprojectMerc[1].z > 0.5) texUv1.y = min(texUv1.y, 1.0);
      if (uReprojectMerc[1].w > 0.5) texUv1.y = max(texUv1.y, 0.0);
      // Confine the slot to the sub-rect it actually covers. With N:M draping each
      // source tile covers only part of the terrain tile; outside its [0,1] range
      // the sampler would smear the edge texel across the rest, so drop it there.
      inBounds1 = step(0.0, texUv1.x) * step(texUv1.x, 1.0)
                   * step(0.0, texUv1.y) * step(texUv1.y, 1.0);
    }

    vec4 texColor1 = texture2D(uTextures[1], texUv1) * vec4(uColors[1], 1.0);

    if (uIsHillshades[1]) {
      texColor1 = vec4(0.0);
    }
    float alpha1 = texColor1.a * uOpacities[1] * inBounds1;
    if (alpha1 > 0.01) {
      compositedColor = mix(compositedColor, vec4(texColor1.rgb, 1.0), alpha1);
      winningSlot = 1;
      isTexturized = 0.0;

    }
  }


  if (uIsHillshades[0]) {
    ivec2 normalMapSize0 = textureSize(uTextures[0], 0);
    if (normalMapSize0.x > 1 && normalMapSize0.y > 1) {
      vec2 hillshadeUv0 = clamp(vUv * uLayerUvScale[0] + uLayerUvOffset[0], vec2(0.0), vec2(1.0));
      vec3 n0 = texture2D(uTextures[0], hillshadeUv0).rgb * 2.0 - 1.0;
      n0 = normalize(n0);
      n0.xy *= uHillshadeExaggeration;
      n0 = normalize(n0);
      hillshadeNormal = n0 * 0.5 + 0.5; // store in [0,1]
      hasHillshadeNormal = true;
    }
  }

  if (uIsHillshades[1]) {
    ivec2 normalMapSize1 = textureSize(uTextures[1], 0);
    if (normalMapSize1.x > 1 && normalMapSize1.y > 1) {
      vec2 hillshadeUv1 = clamp(vUv * uLayerUvScale[1] + uLayerUvOffset[1], vec2(0.0), vec2(1.0));
      vec3 n1 = texture2D(uTextures[1], hillshadeUv1).rgb * 2.0 - 1.0;
      n1 = normalize(n1);
      n1.xy *= uHillshadeExaggeration;
      n1 = normalize(n1);
      hillshadeNormal = n1 * 0.5 + 0.5; // store in [0,1]
      hasHillshadeNormal = true;
    }
  }

  colorBuffer = compositedColor;

  // Attr.a packs the winning slot index as (idx+1)/255 — 0 means no winner.
  // Main shader: int winIdx = int(round(attr.a * 255.0)) - 1.
  attrBuffer = vec4(
    isWater,
    isTexturized,
    0.0,
    float(winningSlot + 1) / 255.0
  );

  normalBuffer = vec4(hillshadeNormal, hasHillshadeNormal ? 1.0 : 0.0);
}
"
`;

