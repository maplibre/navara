{
  "extends": "../tsconfig.common.json",
  "compilerOptions": {
    "noEmit": true,
    "paths": {
      "@navaramap/three": ["./src"],
      "@navaramap/three-default-descs": ["../navara_three_default_descs/src"],
      "@navaramap/three-default-plugin": ["../navara_three_default_plugin/src"],
      "@navaramap/three-plugins": ["../navara_three_plugins/src"],
      "@navaramap/three-debug": ["../navara_three_debug/src"],

      "@navaramap/maplibre-style": ["../navara_maplibre_style/src"],
      "@navaramap/three-api": ["../navara_three_api/src"],
      "@navaramap/core": ["../navara_core/src"],
      "@navaramap/font": ["../navara_font/src"],
      "@navaramap/worker": ["../navara_worker/src"],
      "@navaramap/three-csm": ["../navara_three_csm/src"],
      "@navaramap/three-react": ["../navara_three_react/src"],
      "@shaders/*": ["../../shaders"],
      "@/components/*": ["./example/components/*"],
      "@/lib/*": ["./example/lib/*"],
      "@/lib/utils": ["./example/lib/utils"]
    }
  },
  "include": ["src", "example", "vite-plugin-mpa.ts"],
  "exclude": ["./dist", "./node_modules"]
}
